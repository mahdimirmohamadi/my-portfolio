---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Window from '../../components/ui/Window.astro';
import Nix from '../../components/art/Nix.astro';
import { langPaths, langFromParam, useT, lp } from '../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = useT(lang);
---

<BaseLayout lang={lang} title={t('lab.title')} noindex>
  <section class="lab wrap" aria-labelledby="lab-title">
    <Nix mood="music" size={130} />
    <Window title="systemctl status lofi-radio pomodoro" shadow="amber" class="lab__win">
      <pre class="lab__out mono"><span class="t-dim">● lofi-radio.service</span>
   Loaded: <b class="t-amber">not-found</b> (reason: still compiling)
   Active: inactive (dead)

<span class="t-dim">● pomodoro.timer</span>
   Loaded: <b class="t-amber">not-found</b>
   Active: inactive (waiting)</pre>
      <h1 id="lab-title" class="lab__title">{t('lab.title')}</h1>
      <p>{t('lab.body')}</p>
      <p><a class="btn" href={lp(lang, '/')}>{t('lab.back')}</a></p>
    </Window>
  </section>
</BaseLayout>

<style>
  .lab {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    padding-block-start: var(--space-xl);
    max-width: 44rem;
  }
  :global(.lab__win) {
    width: 100%;
  }
  :global(.lab__win .win__body) {
    display: grid;
    gap: var(--space-s);
  }
  .lab__out {
    margin: 0;
    padding: var(--space-s);
    border-radius: var(--radius-sm);
    background: var(--glass-deep);
    border: 1px solid var(--glass-line);
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-soft);
    direction: ltr;
    text-align: left;
    white-space: pre-wrap;
  }
  .t-dim {
    color: var(--text-faint);
  }
  .t-amber {
    color: var(--amber);
  }
  .lab__title {
    font-size: var(--step-3);
    direction: ltr;
  }
</style>
