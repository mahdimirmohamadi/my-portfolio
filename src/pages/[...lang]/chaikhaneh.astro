---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Simo from '../../components/art/Simo.astro';
import { langPaths, langFromParam, useT, lp, formatNum } from '../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = useT(lang);
---

<BaseLayout lang={lang} title={t('rest.title')} noindex>
  <section class="rest wrap" aria-labelledby="rest-title">
    <div class="rest__scene panel">
      <svg class="rest__shutter" viewBox="0 0 400 220" aria-hidden="true" preserveAspectRatio="none">
        <rect x="0" y="0" width="400" height="220" fill="var(--paper-shade)" />
        <g stroke="var(--line-color)" stroke-width="3">
          {Array.from({ length: 11 }, (_, i) => <line x1="0" x2="400" y1={i * 20 + 10} y2={i * 20 + 10} />)}
        </g>
      </svg>
      <!-- samovar -->
      <svg class="rest__samovar" viewBox="0 0 120 150" aria-hidden="true">
        <g stroke="#16130f" stroke-width="3" stroke-linejoin="round" filter="url(#wobble)">
          <path class="steam idle-float" d="M58 18c-6-6 6-10 0-16M70 20c-6-6 6-10 0-16" fill="none" />
          <path d="M44 24h32l-4 10H48Z" fill="#f2b705" />
          <path d="M34 34h52c8 20 8 50-4 66H38C26 84 26 54 34 34Z" fill="#b3261e" />
          <path d="M40 60h40" fill="none" />
          <path d="M86 70h14v8H86" fill="#f2b705" />
          <path d="M44 100h32l6 20H38Z" fill="#f2b705" />
          <path d="M30 120h60v10H30Z" fill="#16130f" />
        </g>
      </svg>
      <div class="rest__sign misreg">
        <p class="rest__no">{t('ch')} {formatNum(lang, 7)}</p>
        <h1 id="rest-title">{t('rest.title')}</h1>
        <p class="rest__plain">{t('rest.plain')}</p>
      </div>
    </div>
    <div class="rest__body">
      <Simo pose="sleep" size={100} />
      <p>{t('rest.body')}</p>
    </div>
    <p><a class="btn misreg" href={lp(lang, '/')}>{t('rest.back')}</a></p>
  </section>
</BaseLayout>

<style>
  .rest {
    display: grid;
    gap: var(--space-l);
    padding-block-start: var(--space-l);
    max-width: 52rem;
  }
  .rest__scene {
    position: relative;
    padding: 0;
    min-height: 280px;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .rest__shutter {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .rest__samovar {
    position: absolute;
    inset-inline-start: 6%;
    inset-block-end: 0;
    width: 110px;
  }
  .rest__sign {
    --fill: var(--saffron);
    position: relative;
    text-align: center;
    padding: var(--space-s) var(--space-m);
    border: var(--line) solid #16130f;
    background: #f4ecda;
    color: #16130f;
    rotate: calc(-3deg * var(--dir));
  }
  .rest__sign h1 {
    font-size: var(--step-4);
  }
  .rest__no,
  .rest__plain {
    font-family: var(--ff-hand);
    font-weight: 700;
  }
  .rest__body {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    font-size: var(--step-1);
  }
</style>
