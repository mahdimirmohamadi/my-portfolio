---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostRow from '../../../../components/blog/PostRow.astro';
import { getPosts, tagSlug } from '../../../../lib/content';
import { LANGS, useT, lp } from '../../../../i18n/utils';
import type { Lang } from '../../../../i18n/ui';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LANGS) {
    const posts = await getPosts(lang);
    const tags = new Map<string, string>();
    posts.forEach((p) => p.data.tags.forEach((tag) => tags.set(tagSlug(tag), tag)));
    for (const [slug, tag] of tags) {
      paths.push({
        params: { lang: lang === 'en' ? undefined : lang, tag: slug },
        props: { lang, tag, posts: posts.filter((p) => p.data.tags.some((x) => tagSlug(x) === slug)) },
      });
    }
  }
  return paths;
}

const { lang, tag, posts } = Astro.props as { lang: Lang; tag: string; posts: Awaited<ReturnType<typeof getPosts>> };
const t = useT(lang);
---

<BaseLayout lang={lang} title={`#${tag} · ${t('blog.title')}`} altHref={lp(lang === 'fa' ? 'en' : 'fa', '/blog')}>
  <section class="wrap tagpage">
    <p class="mono crumb"><a href={lp(lang, '/blog')}>~/blog</a> | grep <b>#{tag}</b></p>
    <h1 class="tagpage__title">#{tag}</h1>
    <div class="tagpage__list">
      {posts.map((post) => <PostRow lang={lang} post={post} headingLevel="h2" />)}
    </div>
  </section>
</BaseLayout>

<style>
  .tagpage {
    padding-block-start: var(--space-xl);
  }
  .crumb {
    font-size: 0.85rem;
    color: var(--text-faint);
    direction: ltr;
    text-align: start;
  }
  .crumb b {
    color: var(--lime-ink);
  }
  .tagpage__title {
    font-size: var(--step-4);
    margin-block: var(--space-s) var(--space-l);
  }
  .tagpage__list {
    display: grid;
    gap: var(--space-m);
  }
</style>
