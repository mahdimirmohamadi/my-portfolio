---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { splitId, slugOf, tagSlug, getPosts, type Post } from '../../../lib/content';
import { useT, lp, formatDate, formatNum, readingMinutes } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import { Image } from 'astro:assets';
import face from '../../../assets/photo/mahdi-original.png';
import Arrow from '../../../components/ui/Arrow.astro';
import Nix from '../../../components/art/Nix.astro';

export async function getStaticPaths() {
  const all = await getCollection('blog', (p) => import.meta.env.DEV || !p.data.draft);
  return all.map((post) => {
    const { lang, slug } = splitId(post.id);
    return { params: { lang: lang === 'en' ? undefined : lang, slug }, props: { post, lang } };
  });
}

const { post, lang } = Astro.props as { post: Post; lang: Lang };
const t = useT(lang);
const slug = slugOf(post);
const { Content } = await render(post);
const other: Lang = lang === 'fa' ? 'en' : 'fa';

let altHref = lp(other, '/blog');
if (post.data.translationKey) {
  const twin = (await getPosts(other)).find((p) => p.data.translationKey === post.data.translationKey);
  if (twin) altHref = lp(other, `/blog/${slugOf(twin)}`);
}
const posts = await getPosts(lang);
const idx = posts.findIndex((p) => p.id === post.id);
const next = posts[idx + 1] ?? posts.find((p) => p.id !== post.id);
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.description} altHref={altHref} progress ogType="article">
  <article class="post wrap">
    <p class="crumb">
      <a class="arrow-link back" href={lp(lang, '/blog')}><Arrow />{t('blog.back')}</a>
    </p>
    <header class="post__head">
      <h1 class="post__title" style={`view-transition-name: post-${slug}`}>{post.data.title}</h1>
      <p class="post__desc">{post.data.description}</p>
      <div class="post__byline">
        <Image class="post__face" src={face} width={88} height={88} format="webp" alt="" />
        <p>
          <strong>{t('site.name')}</strong><br />
          <span class="post__meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(lang, post.data.pubDate)}</time>
            <span aria-hidden="true"> / </span>
            {formatNum(lang, readingMinutes(post.body))} {t('blog.min')}
          </span>
        </p>
      </div>
      {
        post.data.tags.length > 0 && (
          <ul class="post__tags" role="list" aria-label={t('blog.tagged')}>
            {post.data.tags.map((tag) => (
              <li>
                <a class="chip" href={lp(lang, `/blog/tags/${tagSlug(tag)}`)}>
                  #{tag}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post__end">
      <div class="eof">
        <Nix mood="bow" size={80} class="eof__nix" />
        <p>{t('blog.eof')}</p>
      </div>
      {
        next && (
          <a class="next" href={lp(lang, `/blog/${slugOf(next)}`)}>
            <span class="next__label">{t('blog.next')}</span>
            <span class="next__title">{next.data.title}</span>
          </a>
        )
      }
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    padding-block-start: var(--space-xl);
  }
  .back {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .back :global(svg) {
    scale: -1 1;
  }
  :global(:root[dir='rtl']) .back :global(svg) {
    scale: 1 1;
  }
  .post__head {
    max-width: var(--measure);
    margin-block: var(--space-m) var(--space-xl);
    padding-block-end: var(--space-l);
    border-block-end: 1px solid var(--rule);
  }
  .post__title {
    font-size: var(--step-4);
  }
  .post__desc {
    margin-block-start: var(--space-s);
    font-size: var(--step-1);
    color: var(--text-soft);
  }
  .post__byline {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-m);
    font-size: var(--step--1);
    line-height: 1.45;
  }
  .post__face {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 32% 30%;
    border: 1px solid var(--shell-skirt);
  }
  .post__meta {
    color: var(--text-faint);
  }
  :global(:root[dir='rtl']) .post__meta {
    font-family: var(--ff-body);
  }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: var(--space-s);
  }
  .post__end {
    max-width: var(--measure);
    margin-block-start: var(--space-xl);
    display: grid;
    gap: var(--space-l);
  }
  /* Nix bows at the end of every post */
  .eof {
    display: flex;
    align-items: flex-end;
    gap: var(--space-s);
    font-family: var(--ff-display);
    font-size: var(--step-1);
    color: var(--ink-soft);
  }
  .eof p {
    margin-block-end: 0.6rem;
  }
  :global(:root[dir='rtl']) .eof :global(.eof__nix) {
    transform: scaleX(-1);
  }
  .next {
    display: grid;
    gap: 0.2rem;
    padding-block: var(--space-m);
    border-block: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .next__label {
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .next__title {
    font-family: var(--ff-display);
    font-size: var(--step-2);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.2em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .next:hover .next__title {
    text-decoration-color: var(--lime-ink);
  }
</style>
