---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Treasury from '../../../components/chapters/Treasury.astro';
import { langPaths, langFromParam, useT } from '../../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = useT(lang);
---

<BaseLayout lang={lang} title={`${t('ch.treasury')} · ${t('nav.artifacts.plain')}`}>
  <Treasury lang={lang} standalone />
</BaseLayout>
