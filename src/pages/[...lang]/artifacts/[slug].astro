---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sigil from '../../../components/art/Sigil.astro';
import Simo from '../../../components/art/Simo.astro';
import { getCollection } from 'astro:content';
import { splitId, slugOf, type Artifact } from '../../../lib/content';
import { useT, lp } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const items = await getCollection('artifacts');
  return items.map((item) => {
    const { lang, slug } = splitId(item.id);
    return { params: { lang: lang === 'en' ? undefined : lang, slug }, props: { item, lang } };
  });
}

const { item, lang } = Astro.props as { item: Artifact; lang: Lang };
const t = useT(lang);
const slug = slugOf(item);
const { Content } = await render(item);
const other = lang === 'fa' ? 'en' : 'fa';
---

<BaseLayout lang={lang} title={item.data.title} description={item.data.summary} altHref={lp(other, `/artifacts/${slug}`)}>
  <article class="scroll-page wrap">
    <a class="back" href={lp(lang, '/artifacts')}>{lang === 'fa' ? '→' : '←'} {t('artifacts.all')}</a>
    <header class="scroll-head panel tone tone--light">
      <div class="scroll-head__sigil misreg"><Sigil kind={item.data.sigil} size={80} /></div>
      <p class="scroll-head__epithet">{item.data.epithet}</p>
      <h1 class="scroll-head__title" style={`view-transition-name: artifact-${slug}`}>{item.data.title}</h1>
      <p class="scroll-head__summary">{item.data.summary}</p>
      {
        item.data.url && (
          <p>
            <a class="btn misreg" href={item.data.url} target="_blank" rel="noopener">
              {t('artifacts.visit')} ↗
            </a>
          </p>
        )
      }
      <div class="scroll-head__simo" aria-hidden="true"><Simo pose="spyglass" size={100} /></div>
    </header>
    <div class="scroll-body">
      <div class="prose">
        <Content />
      </div>
      <aside class="stack panel panel--well">
        <h2 class="stack__title">{t('artifacts.stack')}</h2>
        <ul role="list">
          {item.data.stack.map((s) => <li class="ltr">{s}</li>)}
        </ul>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .scroll-page {
    padding-block-start: var(--space-l);
  }
  .back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 700;
    margin-block-end: var(--space-s);
  }
  .scroll-head {
    position: relative;
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-l);
  }
  .scroll-head__sigil {
    --fill: var(--paper-shade);
    justify-self: start;
    display: grid;
    place-items: center;
    width: 104px;
    height: 104px;
    border: var(--line) solid var(--line-color);
  }
  .scroll-head__epithet {
    font-family: var(--ff-hand);
    font-weight: 700;
    color: var(--pomegranate);
  }
  .scroll-head__title {
    font-size: var(--step-4);
  }
  .scroll-head__summary {
    font-size: var(--step-1);
    max-width: 50ch;
  }
  .scroll-head__simo {
    position: absolute;
    inset-block-start: -40px;
    inset-inline-end: var(--space-m);
  }
  .scroll-body {
    display: grid;
    gap: var(--space-l);
    margin-block-start: var(--space-xl);
  }
  @media (min-width: 900px) {
    .scroll-body {
      grid-template-columns: minmax(0, 1fr) 18rem;
      align-items: start;
    }
    .stack {
      position: sticky;
      inset-block-start: var(--space-m);
    }
  }
  .stack__title {
    font-size: var(--step-1);
    margin-block-end: var(--space-xs);
  }
  .stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
  }
  .stack li {
    padding: 0.15em 0.6em;
    border: var(--line-thin) solid var(--line-color);
    background: var(--paper);
    font-weight: 700;
    font-size: var(--step--1);
  }
</style>
