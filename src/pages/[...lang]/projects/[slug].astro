---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Window from '../../../components/ui/Window.astro';
import { splitId, slugOf, type Project } from '../../../lib/content';
import { useT, lp } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import { shotOf } from '../../../lib/shots';
import Arrow from '../../../components/ui/Arrow.astro';
import BrowserFrame from '../../../components/ui/BrowserFrame.astro';

export async function getStaticPaths() {
  const items = await getCollection('projects');
  return items.map((item) => {
    const { lang, slug } = splitId(item.id);
    return { params: { lang: lang === 'en' ? undefined : lang, slug }, props: { item, lang } };
  });
}

const { item, lang } = Astro.props as { item: Project; lang: Lang };
const t = useT(lang);
const slug = slugOf(item);
const { Content } = await render(item);
const other = lang === 'fa' ? 'en' : 'fa';
const shot = shotOf(slug);
---

<BaseLayout lang={lang} title={item.data.title} description={item.data.summary} altHref={lp(other, `/projects/${slug}`)}>
  <article class="readme wrap">
    <p class="crumb">
      <a class="arrow-link back" href={lp(lang, '/projects')}><Arrow />{t('projects.all')}</a>
    </p>
    <header class="readme__head">
      <h1 class="readme__title" style={`view-transition-name: proj-${slug}`}>{item.data.title}</h1>
      <p class="readme__summary">{item.data.summary}</p>
      <p class="readme__kind caption">{item.data.kind}</p>
      {
        item.data.url && (
          <p>
            <a class="btn" href={item.data.url} target="_blank" rel="noopener">
              {t('projects.visit')}
              <Arrow kind="out" />
            </a>
          </p>
        )
      }
    </header>
    {
      shot && (
        <div class="readme__shot">
          <BrowserFrame src={shot} url={item.data.url} sizes="(min-width: 1040px) 1000px, 100vw" eager />
        </div>
      )
    }
    <div class="readme__body">
      <div class="prose">
        <Content />
      </div>
      <Window title="package.json" class="stack" as="aside">
        <pre class="stack__json mono">{'{\n  "dependencies": {\n'}{item.data.stack.map((s, i) => `    "${s}": "*"${i < item.data.stack.length - 1 ? ',' : ''}\n`).join('')}{'  }\n}'}</pre>
      </Window>
    </div>
  </article>
</BaseLayout>

<style>
  .readme {
    padding-block-start: var(--space-xl);
  }
  .back {
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .back :global(svg) {
    scale: -1 1;
  }
  :global(:root[dir='rtl']) .back :global(svg) {
    scale: 1 1;
  }
  .readme__head {
    display: grid;
    gap: var(--space-xs);
    margin-block: var(--space-l) var(--space-xl);
    padding-block-end: var(--space-l);
    border-block-end: 1px solid var(--rule);
  }
  .readme__kind {
    color: var(--text-faint);
  }
  .readme__shot {
    margin: 0 0 var(--space-xl);
  }
  .readme__title {
    font-size: var(--step-4);
  }
  .readme__summary {
    font-size: var(--step-1);
    color: var(--text-soft);
    max-width: 60ch;
  }
  .readme__body {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 900px) {
    .readme__body {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: start;
    }
    :global(.stack) {
      position: sticky;
      inset-block-start: 24px;
    }
  }
  .stack__json {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-soft);
    direction: ltr;
    text-align: left;
    white-space: pre-wrap;
  }
</style>
