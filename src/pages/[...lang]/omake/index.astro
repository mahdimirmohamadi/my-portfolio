---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChapterHead from '../../../components/ui/ChapterHead.astro';
import PostCard from '../../../components/omake/PostCard.astro';
import Simo from '../../../components/art/Simo.astro';
import { getPosts, tagSlug } from '../../../lib/content';
import { langPaths, langFromParam, useT, lp, formatNum } from '../../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = useT(lang);
const posts = await getPosts(lang);
const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout lang={lang} title={`${t('ch.omake')} · ${t('nav.omake.plain')}`}>
  <section class="chapter wrap omake" aria-labelledby="omake-title">
    <ChapterHead no={`${t('ch')} ${formatNum(lang, 5)}`} title={t('ch.omake')} plain={t('ch.omake.plain')} id="omake-title" />
    {
      tags.length > 0 && (
        <ul class="omake__tags" role="list" aria-label={t('omake.tagged')}>
          {tags.map((tag) => (
            <li>
              <a class="tag misreg" href={lp(lang, `/omake/tags/${tagSlug(tag)}`)}>
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    {
      posts.length ? (
        <div class="omake__list">
          {posts.map((post) => (
            <PostCard lang={lang} post={post} headingLevel="h2" />
          ))}
        </div>
      ) : (
        <div class="omake__empty panel tone tone--light">
          <Simo pose="sleep" size={110} />
          <p>{t('omake.empty')}</p>
        </div>
      )
    }
    <p class="omake__rss"><a href={lang === 'fa' ? '/fa/rss.xml' : '/rss.xml'}>{t('omake.rss')}</a></p>
  </section>
</BaseLayout>

<style>
  .omake {
    padding-block-start: var(--space-l);
  }
  .omake__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7em;
    margin-block-end: var(--space-l);
  }
  .omake__list {
    display: grid;
    gap: calc(var(--gutter) * 1.5);
    max-width: 52rem;
  }
  .omake__empty {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }
  .omake__rss {
    margin-block-start: var(--space-l);
    font-weight: 700;
  }
</style>
