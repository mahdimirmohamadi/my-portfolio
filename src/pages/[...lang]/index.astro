---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/home/Hero.astro';
import Whoami from '../../components/home/Whoami.astro';
import GitLog from '../../components/home/GitLog.astro';
import AiLoop from '../../components/home/AiLoop.astro';
import Projects from '../../components/home/Projects.astro';
import Htop from '../../components/home/Htop.astro';
import Marquee from '../../components/home/Marquee.astro';
import BlogTeaser from '../../components/home/BlogTeaser.astro';
import Contact from '../../components/home/Contact.astro';
import { langPaths, langFromParam } from '../../i18n/utils';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
---

<BaseLayout lang={lang}>
  <Hero lang={lang} />
  <Whoami lang={lang} />
  <GitLog lang={lang} />
  <AiLoop lang={lang} />
  <Projects lang={lang} />
  <Htop lang={lang} />
  <Marquee />
  <BlogTeaser lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
