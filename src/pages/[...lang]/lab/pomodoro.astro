---
// ~/lab/pomodoro. The app is a React island (client-only: everything it shows lives in the
// visitor's browser); the page hands it its strings, Nix's six phase poses and the reward
// images, which are every file in src/assets/anime/ (drop one in and it joins the deck).
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Pomodoro from '../../../components/lab/pomodoro/Pomodoro.tsx';
import '../../../components/lab/pomodoro/pomodoro.css';
import { langPaths, langFromParam, useT } from '../../../i18n/utils';
import { ui } from '../../../i18n/ui';
import desk from '../../../assets/nix/nix-desk.png';
import typing from '../../../assets/nix/nix-type.png';
import think from '../../../assets/nix/nix-think.png';
import tea from '../../../assets/nix/nix-tea.png';
import sleep from '../../../assets/nix/nix-sleep.png';
import thumbs from '../../../assets/nix/nix-thumbs.png';

export const getStaticPaths = langPaths;
const lang = langFromParam(Astro.params.lang);
const t = useT(lang);

const strings = Object.fromEntries(Object.entries(ui[lang]).filter(([k]) => k.startsWith('pomo.'))) as Record<string, string>;

const NIX_W = 240; // 2x the rendered 120px
const poseList = { desk, type: typing, think, tea, sleep, thumbs };
const poses = Object.fromEntries(
  await Promise.all(
    Object.entries(poseList).map(async ([k, src]) => {
      const img = await getImage({ src, width: NIX_W, format: 'webp', quality: 82 });
      return [k, { src: img.src, w: NIX_W, h: Math.round((src.height / src.width) * NIX_W) }];
    }),
  ),
);

const files = import.meta.glob<{ default: ImageMetadata }>('../../../assets/anime/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const images = await Promise.all(
  Object.entries(files)
    .sort(([a], [b]) => a.localeCompare(b))
    .map(async ([path, mod]) => {
      const src = mod.default;
      const w = Math.min(src.width, 960);
      const img = await getImage({ src, width: w, format: 'webp', quality: 84 });
      return { id: path.split('/').pop()!.replace(/\.[^.]+$/, ''), src: img.src, w, h: Math.round((src.height / src.width) * w) };
    }),
);
---

<BaseLayout lang={lang} title={t('pomo.title')} description={t('pomo.lead')}>
  <section class="pomo-page wrap" aria-labelledby="pomo-title">
    <header class="pomo-page__head">
      <div>
        <h1 id="pomo-title" class="pomo-page__title">{t('pomo.title')}</h1>
        <p class="pomo-page__lead">{t('pomo.lead')}</p>
      </div>
      <!-- Nix stands here, on the timer's top edge; the island swaps his pose with the phase -->
      <span id="pomo-nix-spot" class="pomo-nix-spot"><img src={poses.desk.src} width={poses.desk.w} height={poses.desk.h} alt="" /></span>
    </header>
    <Pomodoro client:only="react" lang={lang} strings={strings} images={images} poses={poses as any}>
      <div slot="fallback" class="pomo-fallback" aria-busy="true">
        <div class="pomo-device">
          <div class="pomo-screen screen">
            <div class="pomo-clock" aria-hidden="true">{lang === 'fa' ? '۲۵:۰۰' : '25:00'}</div>
          </div>
          <p class="caption">{t('pomo.loading')}</p>
        </div>
      </div>
    </Pomodoro>
  </section>
</BaseLayout>
