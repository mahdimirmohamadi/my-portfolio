---
/* One static 404 for both languages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Nix from '../components/art/Nix.astro';
import Window from '../components/ui/Window.astro';
import { ui } from '../i18n/ui';
---

<BaseLayout lang="en" title="404" noindex>
  <section class="panic wrap" aria-labelledby="panic-title">
    <Nix mood="search" size={140} />
    <Window title="dmesg | tail" shadow="coral" class="panic__win">
      <pre class="panic__log mono">[    0.000000] Linux version 6.x (mahdi@workstation)
[    4.200404] <b>Kernel panic - not syncing: VFS: Unable to mount path</b>
[    4.200405] ---[ end Kernel panic ]---</pre>
      <h1 id="panic-title" class="panic__title">{ui.en['404.title']}</h1>
      <p>{ui.en['404.body']}</p>
      <p lang="fa" dir="rtl" class="panic__fa">{ui.fa['404.body']}</p>
      <p class="panic__links">
        <a class="btn" href="/">{ui.en['404.home']}</a>
        <a class="btn btn--ghost" href="/fa/" lang="fa">نسخهٔ فارسی</a>
      </p>
    </Window>
  </section>
</BaseLayout>

<style>
  .panic {
    display: grid;
    justify-items: center;
    gap: var(--space-m);
    padding-block-start: var(--space-xl);
    max-width: 46rem;
  }
  :global(.panic__win) {
    width: 100%;
  }
  :global(.panic__win .win__body) {
    display: grid;
    gap: var(--space-s);
  }
  .panic__log {
    margin: 0;
    padding: var(--space-s);
    border-radius: var(--radius-sm);
    background: var(--bg-2);
    font-size: 0.78rem;
    line-height: 1.6;
    color: var(--text-soft);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .panic__log b {
    color: var(--coral);
  }
  .panic__title {
    font-size: var(--step-3);
  }
  .panic__fa {
    font-family: var(--font-fa);
    color: var(--text-soft);
  }
  .panic__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }
</style>
