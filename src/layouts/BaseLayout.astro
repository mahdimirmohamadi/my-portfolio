---
import '../styles/global.css';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import TopPanel from '../components/chrome/TopPanel.astro';
import Dock from '../components/chrome/Dock.astro';
import StatusLine from '../components/chrome/StatusLine.astro';
import type { Lang } from '../i18n/ui';
import { useT, dirOf, switchLangPath } from '../i18n/utils';
import ogDefault from '../assets/og/og-default.png';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** href of this page in the other language (defaults to the same path) */
  altHref?: string;
  noindex?: boolean;
  progress?: boolean;
  ogType?: 'website' | 'article';
  /** preload the display face (big titles are the LCP) */
  preloadDisplay?: boolean;
}

const { lang, title, description, altHref, noindex = false, progress = false, ogType = 'website', preloadDisplay = true } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'fa' ? 'en' : 'fa';
const pageTitle = title ? `${title} · ${t('site.name')}` : `${t('site.name')} · ${t('site.role')}`;
const desc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const altPath = altHref ?? switchLangPath(Astro.url.pathname, other);
const enHref = new URL(lang === 'en' ? Astro.url.pathname : altPath, Astro.site);
const faHref = new URL(lang === 'fa' ? Astro.url.pathname : altPath, Astro.site);
const ogImage = new URL(ogDefault.src, Astro.site);
---

<!doctype html>
<html lang={lang === 'fa' ? 'fa-IR' : 'en'} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="fa" href={faHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <link rel="alternate" type="application/rss+xml" title={`${t('blog.title')} · ${t('site.name')}`} href={lang === 'fa' ? '/fa/rss.xml' : '/rss.xml'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0c09" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'fa' ? 'fa_IR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- fonts: this locale's body (+ display on content pages) preloaded; the rest swap in -->
    {
      lang === 'fa' ? (
        <Font cssVariable="--font-fa" preload={[{ subset: 'arabic' }]} />
      ) : (
        <Font cssVariable="--font-body" preload={[{ subset: 'latin', weight: '400' }]} />
      )
    }
    {lang === 'fa' ? <Font cssVariable="--font-body" /> : <Font cssVariable="--font-fa" />}
    <Font cssVariable="--font-display" preload={preloadDisplay && lang === 'en' ? [{ subset: 'latin' }] : false} />
    <Font cssVariable="--font-mono" />

    <!-- theme (dark-first) + low-end detection before first paint; re-applied on page turns -->
    <script is:inline>
      (() => {
        const apply = (root) => {
          let theme = null;
          try {
            theme = localStorage.getItem('theme');
          } catch {}
          if (theme === 'light') root.dataset.theme = 'light';
          else delete root.dataset.theme;
          const c = navigator.connection;
          if ((c && c.saveData) || (navigator.hardwareConcurrency || 8) <= 4) root.dataset.lite = '';
        };
        apply(document.documentElement);
        document.addEventListener('astro:before-swap', (ev) => apply(ev.newDocument.documentElement));
      })();
    </script>

    <ClientRouter fallback="none" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>
    {progress && <div class="read-progress" aria-hidden="true" />}
    <TopPanel lang={lang} altHref={altPath} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <StatusLine lang={lang} />
    <Dock lang={lang} />
    <!-- reserved: the ~/lab dock (lofi radio + pomodoro) mounts here later,
         as <LabDock client:idle transition:persist="lab-dock" /> -->
    <div class="dock-slot" transition:persist="lab-dock"><slot name="dock" /></div>
  </body>
</html>

<script>
  import '../scripts/chrome';
  import '../scripts/fx/spark';
</script>

<style>
  .skip {
    position: fixed;
    inset-block-start: 8px;
    inset-inline-start: 8px;
    z-index: 100;
    padding: 0.6em 1em;
    background: var(--lime);
    color: #0b0c09;
    border: var(--bw) solid #0b0c09;
    border-radius: var(--radius-sm);
    font-weight: 700;
    translate: 0 -200%;
    transition: translate var(--dur-ui) var(--ease-out);
  }
  .skip:focus-visible {
    translate: 0 0;
  }
  main {
    display: block;
    outline: none;
  }
  .dock-slot:empty {
    display: none;
  }
</style>
