---
import type { Lang } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { chapters } from './chapters';

interface Props {
  lang: Lang;
  altHref: string;
}
const { lang, altHref } = Astro.props;
const t = useT(lang);
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (path: string) => {
  const target = lp(lang, path).replace(/\/$/, '') || '/';
  return !path.includes('#') && path !== '/' && here.startsWith(target);
};
const desktopNav = chapters.filter((c) => c.path !== '/');
---

<header class="masthead">
  <div class="masthead__inner wrap">
    <a class="brand" href={lp(lang, '/')} aria-label={`${t('site.name')} · ${t('nav.cover')}`}>
      <span class="brand__vol misreg">{t('cover.vol')}</span>
      <span class="brand__name">{t('site.name')}</span>
    </a>

    <nav class="masthead__nav" aria-label={t('nav.menu')}>
      <ul role="list">
        {
          desktopNav.map((c) => (
            <li>
              <a href={lp(lang, c.path)} aria-current={isActive(c.path) ? 'page' : undefined} class:list={{ soon: c.soon }}>
                {t(c.key)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="masthead__tools">
      <button class="tool edition-toggle" type="button" data-edition-toggle aria-label={t('edition.toggle')} title={t('edition.toggle')}>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <g class="sun" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <circle cx="12" cy="12" r="4.5" fill="currentColor" />
            <path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" />
          </g>
          <path class="moon" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="currentColor" />
        </svg>
      </button>
      <a class="tool lang-switch" href={altHref} hreflang={lang === 'fa' ? 'en' : 'fa'} lang={lang === 'fa' ? 'en' : 'fa'} data-lang-flip aria-label={t('lang.switch.label')}>
        {t('lang.switch')}
      </a>
    </div>
  </div>
</header>

<style>
  .masthead {
    position: relative;
    z-index: 40;
    border-block-end: var(--line) solid var(--line-color);
    background: var(--bg);
  }
  .masthead__inner {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    min-height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    text-decoration: none;
    color: var(--text);
    min-height: 44px;
  }
  .brand__vol {
    --fill: var(--saffron);
    --bw: var(--line-thin);
    white-space: nowrap;
    display: none;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    padding: 0.15em 0.5em;
    border: var(--line-thin) solid var(--line-color);
    color: var(--ink);
  }
  :global(:root[dir='rtl']) .brand__vol {
    font-family: var(--font-fa-display);
    font-size: 1rem;
  }
  :global(:root[data-edition='night']) .brand__vol {
    color: #16130f;
  }
  .brand__name {
    font-family: var(--ff-display);
    font-size: 1.05rem;
    white-space: nowrap;
  }
  :global(:root[dir='rtl']) .brand__name {
    font-size: 1.3rem;
  }

  .masthead__nav {
    display: none;
    margin-inline-start: auto;
  }
  .masthead__nav ul {
    display: flex;
    gap: 0.2rem;
  }
  .masthead__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.7em;
    color: var(--text);
    font-family: var(--ff-hand);
    font-weight: 700;
    font-size: 0.98rem;
    text-decoration: none;
    background-image: linear-gradient(var(--saffron), var(--saffron));
    background-repeat: no-repeat;
    background-position: 50% 78%;
    background-size: 0% 0.42em;
    transition: background-size var(--dur-hover) var(--ease-out);
  }
  .masthead__nav a:hover,
  .masthead__nav a[aria-current='page'] {
    background-size: calc(100% - 1.2em) 0.42em;
  }
  .masthead__nav a.soon {
    color: var(--text-soft);
  }

  .masthead__tools {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-inline-start: auto;
  }
  .tool {
    display: inline-grid;
    place-items: center;
    min-width: 44px;
    min-height: 44px;
    padding-inline: 0.6em;
    border: var(--line-thin) solid var(--line-color);
    color: var(--text);
    background: var(--surface);
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition:
      translate var(--dur-press) var(--ease-out),
      box-shadow var(--dur-press) var(--ease-out);
  }
  .tool:active {
    translate: calc(3px * var(--dir)) 3px;
    box-shadow: none;
  }
  .lang-switch {
    font-family: var(--font-fa-display);
    font-size: 1.05rem;
    padding-inline: 0.8em;
  }
  :global(:root[dir='rtl']) .lang-switch {
    font-family: var(--font-display);
    font-size: 0.85rem;
  }
  .edition-toggle .moon {
    display: none;
  }
  :global(:root[data-edition='night']) .edition-toggle .sun {
    display: none;
  }
  :global(:root[data-edition='night']) .edition-toggle .moon {
    display: block;
  }

  @media (min-width: 480px) {
    .brand__vol {
      display: inline-block;
    }
  }
  @media (min-width: 900px) {
    .masthead__nav {
      display: block;
    }
    .masthead__tools {
      margin-inline-start: var(--space-xs);
    }
  }
</style>
