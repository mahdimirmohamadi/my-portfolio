---
/** Phones: a bottom "chapter bar" in thumb reach + a Contents sheet (native <dialog>). */
import type { Lang } from '../../i18n/ui';
import { useT, lp, formatNum } from '../../i18n/utils';
import { chapters } from './chapters';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const quick = [
  { key: 'nav.cover' as const, path: '/', icon: 'M4 5h7v14H4zM13 5h7v14h-7z' },
  { key: 'nav.artifacts' as const, path: '/artifacts', icon: 'M12 3l3 5 5 1-3.5 4 1 6L12 16l-5.5 3 1-6L4 9l5-1z' },
  { key: 'nav.omake' as const, path: '/omake', icon: 'M5 4h10l4 4v12H5zM15 4v4h4M8 12h8M8 16h6' },
];
---

<nav class="chapter-bar" aria-label={t('nav.menu')}>
  <ul role="list">
    {
      quick.map((q) => (
        <li>
          <a href={lp(lang, q.path)}>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path d={q.icon} fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" />
            </svg>
            <span>{t(q.key)}</span>
          </a>
        </li>
      ))
    }
    <li>
      <button type="button" data-sheet-open aria-haspopup="dialog" aria-controls="contents-sheet">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h10" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" />
        </svg>
        <span>{t('nav.contents')}</span>
      </button>
    </li>
  </ul>
</nav>

<dialog class="sheet" id="contents-sheet" aria-labelledby="sheet-title">
  <div class="sheet__grip" data-sheet-grip aria-hidden="true"><span></span></div>
  <div class="sheet__head">
    <h2 id="sheet-title">{t('nav.contents')}</h2>
    <button type="button" class="sheet__close" data-sheet-close aria-label={t('nav.close')}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" />
      </svg>
    </button>
  </div>
  <ol class="toc" role="list">
    {
      chapters.map((c) => (
        <li>
          <a href={lp(lang, c.path)} data-sheet-link class:list={{ soon: c.soon }}>
            <span class="toc__no tabular">{c.no === '0' ? '◆' : formatNum(lang, Number(c.no))}</span>
            <span class="toc__title">{t(c.key)}</span>
            <span class="toc__plain">{t(c.plain)}</span>
          </a>
        </li>
      ))
    }
  </ol>
</dialog>

<style>
  .chapter-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 50;
    background: var(--bg);
    border-block-start: var(--line) solid var(--line-color);
    padding-block-end: env(safe-area-inset-bottom);
  }
  .chapter-bar ul {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .chapter-bar :is(a, button) {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 2px;
    min-height: 64px;
    width: 100%;
    color: var(--text);
    text-decoration: none;
    font-family: var(--ff-hand);
    font-weight: 700;
    font-size: 0.8rem;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .chapter-bar :is(a, button) svg {
    transition: scale var(--dur-press) var(--ease-out);
  }
  .chapter-bar :is(a, button):active svg {
    scale: 0.88;
  }
  .chapter-bar li + li {
    border-inline-start: var(--line-thin) solid var(--line-color);
  }
  @media (min-width: 900px) {
    .chapter-bar {
      display: none;
    }
  }

  /* ── Contents sheet ── */
  .sheet {
    --sheet-y: 0px;
    position: fixed;
    inset-inline: 0;
    inset-block: auto 0;
    margin: 0;
    width: 100%;
    max-width: 100%;
    max-height: min(86dvh, 640px);
    padding: 0 var(--page-gutter) calc(var(--space-m) + env(safe-area-inset-bottom));
    border: 0;
    border-block-start: var(--line) solid var(--line-color);
    background: var(--bg);
    color: var(--text);
    overflow-y: auto;
    overscroll-behavior: contain;
    translate: 0 var(--sheet-y);
    transition:
      translate 250ms var(--ease-drawer),
      overlay 250ms allow-discrete,
      display 250ms allow-discrete;
  }
  .sheet:not([open]) {
    translate: 0 100%;
  }
  @starting-style {
    .sheet[open] {
      translate: 0 100%;
    }
  }
  .sheet.is-dragging {
    transition: none;
  }
  .sheet::backdrop {
    background: color-mix(in srgb, #16130f 55%, transparent);
    opacity: 1;
    transition:
      opacity 250ms ease,
      overlay 250ms allow-discrete,
      display 250ms allow-discrete;
  }
  .sheet:not([open])::backdrop {
    opacity: 0;
  }
  @starting-style {
    .sheet[open]::backdrop {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet,
    .sheet::backdrop {
      transition-duration: 1ms;
    }
  }
  .sheet__grip {
    display: grid;
    place-items: center;
    height: 28px;
    cursor: grab;
    touch-action: none;
  }
  .sheet__grip span {
    width: 48px;
    height: 6px;
    background: var(--line-color);
  }
  .sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-block-end: var(--space-s);
    touch-action: none;
  }
  .sheet__head h2 {
    font-size: var(--step-2);
  }
  .sheet__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: var(--line-thin) solid var(--line-color);
    color: var(--text);
  }
  .toc {
    display: grid;
    gap: 0;
  }
  .toc a {
    display: grid;
    grid-template-columns: 2.4rem 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-xs);
    padding-block: 0.7rem;
    border-block-end: var(--line-thin) dashed color-mix(in srgb, var(--line-color) 40%, transparent);
    color: var(--text);
    text-decoration: none;
    min-height: 56px;
  }
  .toc__no {
    grid-row: span 2;
    display: grid;
    place-items: center;
    align-self: center;
    width: 2.2rem;
    height: 2.2rem;
    border: var(--line-thin) solid var(--line-color);
    background: var(--saffron);
    color: #16130f;
    font-family: var(--font-display);
    font-size: 0.9rem;
  }
  .toc__title {
    font-family: var(--ff-display);
    font-size: var(--step-1);
    line-height: 1.2;
  }
  .toc__plain {
    font-family: var(--ff-hand);
    font-size: var(--step--1);
    color: var(--text-soft);
  }
  .toc a.soon .toc__no {
    background: var(--paper-shade);
  }
</style>
