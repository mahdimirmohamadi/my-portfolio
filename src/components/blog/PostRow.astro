---
/** A note in the list: date on the margin, title, one line, tags (home and /blog). */
import type { Lang } from '../../i18n/ui';
import { useT, lp, formatDate, formatNum, readingMinutes } from '../../i18n/utils';
import { slugOf, tagSlug, type Post } from '../../lib/content';

interface Props {
  lang: Lang;
  post: Post;
  headingLevel?: 'h2' | 'h3';
  showTags?: boolean;
}
const { lang, post, headingLevel: H = 'h3', showTags = true } = Astro.props;
const t = useT(lang);
const slug = slugOf(post);
---

<article class="row">
  <p class="row__date caption"><time datetime={post.data.pubDate.toISOString()}>{formatDate(lang, post.data.pubDate)}</time></p>
  <div class="row__main">
    <H class="row__title">
      <a href={lp(lang, `/blog/${slug}`)} class="row__link" style={`view-transition-name: post-${slug}`}>{post.data.title}</a>
    </H>
    <p class="row__desc">{post.data.description}</p>
    <p class="row__meta">
      <span>{formatNum(lang, readingMinutes(post.body))} {t('blog.min')}</span>
      {post.data.draft && <span class="sticker sticker--coral">draft</span>}
    </p>
    {
      showTags && post.data.tags.length > 0 && (
        <ul class="row__tags" role="list" aria-label={t('blog.tagged')}>
          {post.data.tags.map((tag) => (
            <li>
              <a class="chip" href={lp(lang, `/blog/tags/${tagSlug(tag)}`)}>
                #{tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .row {
    display: grid;
    gap: 0.3rem var(--space-m);
    padding-block: var(--space-m);
    border-block-start: 1px solid var(--rule);
  }
  @media (min-width: 760px) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .row__date {
    padding-block-start: 0.45rem;
  }
  .row__title {
    font-size: var(--step-2);
  }
  .row__link {
    color: var(--ink);
    text-decoration: none;
  }
  .row__link:hover {
    text-decoration: underline;
    text-decoration-color: var(--lime-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .row__desc {
    margin-block-start: 0.4rem;
    max-width: 62ch;
    color: var(--ink-soft);
  }
  .row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.4rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-block-start: 0.6rem;
    list-style: none;
    padding: 0;
  }
</style>
