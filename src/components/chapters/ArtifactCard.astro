---
import type { Lang } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { slugOf, type Artifact } from '../../lib/content';
import Sigil from '../art/Sigil.astro';

interface Props {
  lang: Lang;
  item: Artifact;
  index: number;
}
const { lang, item, index } = Astro.props;
const t = useT(lang);
const slug = slugOf(item);
const href = lp(lang, `/artifacts/${slug}`);
---

<article class:list={['artifact', 'panel', 'reveal', { 'artifact--feature': index === 0 }]}>
  <div class="artifact__sigil misreg" aria-hidden="true"><Sigil kind={item.data.sigil} size={56} /></div>
  <p class="artifact__epithet">{item.data.epithet}</p>
  <h3 class="artifact__title">
    <a href={href} class="artifact__link" style={`view-transition-name: artifact-${slug}`}>{item.data.title}</a>
  </h3>
  <p class="artifact__summary">{item.data.summary}</p>
  <ul class="artifact__stack" role="list" aria-label={t('artifacts.stack')}>
    {item.data.stack.slice(0, 4).map((s) => <li class="ltr">{s}</li>)}
  </ul>
</article>

<style>
  .artifact {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    transition:
      translate var(--dur-hover) var(--ease-out),
      box-shadow var(--dur-hover) var(--ease-out);
  }
  /* the whole card is the click target; the heading link carries the name */
  .artifact__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .artifact__link {
    color: var(--text);
    text-decoration: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .artifact:hover {
      translate: calc(-2px * var(--dir)) -2px;
      box-shadow: var(--shadow-lg);
    }
    .artifact:hover .artifact__link {
      text-decoration: underline;
      text-decoration-color: var(--saffron);
      text-decoration-thickness: 4px;
    }
  }
  .artifact:active {
    translate: calc(3px * var(--dir)) 3px;
    box-shadow: 0 0 0 var(--shadow-color);
    transition-duration: var(--dur-press);
  }
  .artifact__sigil {
    --fill: var(--paper-shade);
    --bw: var(--line-thin);
    justify-self: start;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border: var(--line-thin) solid var(--line-color);
    margin-block-end: var(--space-2xs);
  }
  .artifact__epithet {
    font-family: var(--ff-hand);
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--pomegranate);
  }
  .artifact__title {
    font-size: var(--step-2);
  }
  .artifact__summary {
    color: var(--text-soft);
  }
  .artifact__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    margin-block-start: var(--space-2xs);
    font-size: 0.8rem;
    font-weight: 700;
  }
  .artifact__stack li {
    padding: 0.1em 0.5em;
    border: 1.5px solid var(--line-color);
  }
  /* the first artifact is a wide splash panel: big sigil beside the text */
  @media (min-width: 640px) {
    .artifact--feature {
      grid-column: 1 / -1;
      grid-template-columns: auto 1fr;
      column-gap: var(--space-l);
      align-content: center;
      background-color: var(--paper-shade);
    }
    .artifact--feature > :not(.artifact__sigil) {
      grid-column: 2;
    }
    .artifact--feature .artifact__sigil {
      grid-row: 1 / span 5;
      align-self: center;
      width: 150px;
      height: 150px;
    }
    .artifact--feature .artifact__sigil :global(svg) {
      width: 104px;
      height: 104px;
    }
    .artifact--feature .artifact__title {
      font-size: var(--step-3);
    }
  }
  @media (min-width: 900px) {
    .artifact--feature {
      grid-column: span 2;
    }
  }
</style>
