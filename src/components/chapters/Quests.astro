---
import type { Lang } from '../../i18n/ui';
import { useT, formatNum } from '../../i18n/utils';
import { quests, bosses } from '../../data/chronicle';
import ChapterHead from '../ui/ChapterHead.astro';
import Panel from '../ui/Panel.astro';
import SFX from '../ui/SFX.astro';
import SpeedLines from '../art/SpeedLines.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const city = (en: string, fa: string) => (lang === 'fa' ? fa : en);
const routeD = 'M96 78 C 210 -6, 360 214, 508 150';
---

<section class="chapter wrap" id="quests" aria-labelledby="quests-title">
  <ChapterHead no={`${t('ch')} ${formatNum(lang, 2)}`} title={t('ch.quests')} plain={t('ch.quests.plain')} id="quests-title" />

  <!-- the route: geography is not mirrored in RTL; only labels are localized -->
  <figure class="route panel panel--well tone tone--light reveal-rise" aria-label={t('quest.route')}>
    <svg class="route__map" viewBox="0 0 600 210" aria-hidden="true">
      <defs>
        <mask id="route-mask" maskUnits="userSpaceOnUse">
          <path class="draw-on-scroll" d={routeD} pathLength="1" fill="none" stroke="#fff" stroke-width="16" />
        </mask>
      </defs>
      <g class="route__waves" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
        <path d="M250 150q8-8 16 0t16 0M330 60q8-8 16 0t16 0M420 190q8-8 16 0t16 0M160 170q8-8 16 0t16 0" />
      </g>
      <path class="route__path" d={routeD} mask="url(#route-mask)" />
      <g class="route__pin">
        <circle cx="96" cy="78" r="11" />
        <circle cx="96" cy="78" r="3.5" class="dot" />
      </g>
      <g class="route__pin route__pin--end">
        <circle cx="508" cy="150" r="11" />
        <circle cx="508" cy="150" r="3.5" class="dot" />
      </g>
    </svg>
    <span class="route__label route__label--from">{city('Tehran', 'تهران')}</span>
    <span class="route__label route__label--to">{city('Melbourne', 'ملبورن')}</span>
    <figcaption class="sr-only">{t('quest.route')}</figcaption>
  </figure>

  <div class="quests">
    {
      quests.map((q, i) => (
        <Panel as="article" class="quest" reveal slant={i === 0 ? 'bottom' : undefined}>
          <p class="quest__name">{q.name[lang]}</p>
          <h3 class="quest__company">{q.company}</h3>
          <p class="quest__meta">
            <span>{q.place[lang]}</span>
            <span class="sep" aria-hidden="true"></span>
            <span>{q.mode[lang]}</span>
            <span class="sep" aria-hidden="true"></span>
            <span class="tabular">
              {q.since[lang]} – {t('quest.now')}
            </span>
          </p>
          {q.lead && <p class="quest__lead">{q.lead[lang]}</p>}
          <ul class="quest__deeds">
            {q.deeds[lang].map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </Panel>
      ))
    }
  </div>

  <!-- boss battles -->
  <div class="bosses-head reveal-rise">
    <h3 class="bosses-title">{t('ch.bosses')}</h3>
    <p class="chapter-head__plain">{t('ch.bosses.plain')}</p>
  </div>
  <div class="bosses">
    {
      bosses.map((b, i) => (
        <article class:list={['boss', 'panel', { 'boss--stat': b.stat }]} data-boss={b.stat ? 'stat' : ''}>
          <SpeedLines class="boss__speed" count={b.stat ? 64 : 40} cx={i % 2 ? 80 : 20} cy={30} />
          <p class="boss__quest">{b.quest}</p>
          <h4 class="boss__name">{b.name[lang]}</h4>
          {b.stat && (
            <div class="boss__stat">
              <p class="boss__number tabular">
                <span class="sr-only">{`${formatNum(lang, b.stat.value)}${lang === 'fa' ? '٪' : b.stat.suffix}`}</span>
                <span aria-hidden="true">−</span>
                <span aria-hidden="true" data-ticker={b.stat.value}>{formatNum(lang, b.stat.value)}</span>
                <span aria-hidden="true">{lang === 'fa' ? '٪' : b.stat.suffix}</span>
              </p>
              <p class="boss__label">{b.stat.label[lang]}</p>
              <div class="hp" aria-hidden="true">
                <span class="hp__label">{t('boss.hp')}</span>
                <span class="hp__bar"><span class="hp__fill" data-hp /></span>
              </div>
            </div>
          )}
          <p class="boss__story">{b.story[lang]}</p>
          <SFX en={b.sfx.en} fa={b.sfx.fa} lang={lang} red={i % 2 === 0} class="boss__sfx" data-boss-sfx />
          <span class="stamp boss__stamp" data-boss-stamp>{t('boss.defeated')}</span>
        </article>
      ))
    }
  </div>
</section>

<script>
  import '../../scripts/motion/boss';
</script>

<style>
  /* route */
  .route {
    position: relative;
    margin-block-end: var(--space-l);
    padding: var(--space-s);
  }
  .route__map {
    width: 100%;
    height: auto;
    color: var(--ink-faint);
  }
  .route__path {
    fill: none;
    stroke: var(--pomegranate);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 0.1 13;
  }
  .route__pin circle {
    fill: var(--saffron);
    stroke: #16130f;
    stroke-width: 3;
  }
  .route__pin .dot {
    fill: #16130f;
  }
  .route__label {
    position: absolute;
    font-family: var(--ff-hand);
    font-weight: 700;
    font-size: var(--step-0);
    background: var(--paper);
    border: var(--line-thin) solid var(--line-color);
    padding: 0.05em 0.5em;
    box-shadow: var(--shadow-sm);
  }
  /* positions follow the (unmirrored) map, so use physical left */
  .route__label--from {
    left: 7%;
    top: 58%;
  }
  .route__label--to {
    left: 70%;
    top: 12%;
  }

  /* quests */
  .quests {
    display: grid;
    gap: calc(var(--gutter) * 1.5);
  }
  @media (min-width: 900px) {
    .quests {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .quest__name {
    font-family: var(--ff-hand);
    font-weight: 700;
    color: var(--pomegranate);
  }
  .quest__company {
    font-size: var(--step-3);
    margin-block: 0.1em 0.3em;
  }
  .quest__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    font-size: var(--step--1);
    color: var(--text-soft);
    font-weight: 600;
  }
  .quest__lead {
    margin-block-start: var(--space-s);
    font-style: italic;
  }
  .quest__deeds {
    margin-block-start: var(--space-s);
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7em;
  }
  .quest__deeds li {
    position: relative;
    padding-inline-start: 1.6em;
  }
  .quest__deeds li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0.1em;
    inset-block-start: 0.55em;
    width: 0.62em;
    height: 0.62em;
    background: var(--saffron);
    border: var(--line-thin) solid var(--line-color);
    rotate: 45deg;
  }

  /* bosses */
  .bosses-head {
    margin-block: var(--space-2xl) var(--space-m);
  }
  .bosses-title {
    font-size: var(--step-3);
  }
  .bosses {
    display: grid;
    gap: calc(var(--gutter) * 1.5);
  }
  @media (min-width: 700px) {
    .bosses {
      grid-template-columns: repeat(2, 1fr);
    }
    .boss--stat {
      grid-column: 1 / -1;
    }
  }
  .boss {
    overflow: hidden;
    padding-block-end: var(--space-l);
    min-height: 15rem;
  }
  :global(.boss__speed) {
    opacity: 0.09 !important;
  }
  .boss > :not(:global(.boss__speed), :global(.boss__sfx), .boss__stamp) {
    position: relative;
  }
  .boss__quest {
    font-family: var(--ff-hand);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text-soft);
  }
  .boss__name {
    font-family: var(--ff-display);
    font-weight: 400;
    font-size: var(--step-2);
    line-height: 1.15;
    max-width: 16ch;
  }
  .boss__story {
    margin-block-start: var(--space-xs);
    max-width: 46ch;
  }
  :global(.boss__sfx) {
    position: absolute;
    inset-block-start: var(--space-s);
    inset-inline-end: var(--space-s);
    font-size: calc(var(--step-3) * var(--sfx-k, 1)) !important;
  }
  .boss__stamp {
    position: absolute;
    inset-block-end: var(--space-s);
    inset-inline-end: var(--space-s);
    font-size: var(--step-0);
  }
  .boss--stat {
    background-color: var(--paper-shade);
  }
  .boss__stat {
    display: grid;
    gap: 0.2em;
    margin-block: var(--space-s);
  }
  .boss__number {
    font-family: var(--font-display);
    font-size: clamp(4rem, 3rem + 6vw, 7.5rem);
    line-height: 1;
    color: var(--pomegranate);
    display: flex;
    align-items: baseline;
  }
  :global(:root[dir='rtl']) .boss__number {
    font-family: var(--font-fa-display);
  }
  .boss__label {
    font-family: var(--ff-hand);
    font-weight: 700;
    font-size: var(--step-1);
  }
  .hp {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-block-start: var(--space-xs);
    max-width: 26rem;
  }
  .hp__label {
    font-family: var(--ff-hand);
    font-weight: 700;
    font-size: var(--step--1);
    white-space: nowrap;
  }
  .hp__bar {
    flex: 1;
    height: 18px;
    border: var(--line) solid var(--line-color);
    background: var(--paper);
    overflow: hidden;
  }
  .hp__fill {
    display: block;
    height: 100%;
    background: var(--pomegranate);
    transform-origin: var(--hp-origin, left);
    scale: 0 1; /* defeated: the resting state without JS */
  }
  :global(:root[dir='rtl']) .hp__fill {
    --hp-origin: right;
  }
</style>
