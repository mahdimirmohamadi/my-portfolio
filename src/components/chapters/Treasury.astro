---
import type { Lang } from '../../i18n/ui';
import { useT, lp, formatNum } from '../../i18n/utils';
import { getArtifacts } from '../../lib/content';
import ChapterHead from '../ui/ChapterHead.astro';
import ArtifactCard from './ArtifactCard.astro';

interface Props {
  lang: Lang;
  /** on the home page it's a chapter; on /artifacts it's the whole page */
  standalone?: boolean;
}
const { lang, standalone = false } = Astro.props;
const t = useT(lang);
const items = await getArtifacts(lang);
---

<section class="chapter wrap" id="treasury" aria-labelledby="treasury-title">
  <ChapterHead no={`${t('ch')} ${formatNum(lang, 3)}`} title={t('ch.treasury')} plain={t('ch.treasury.plain')} id="treasury-title" />
  <div class="treasury">
    {items.map((item, i) => <ArtifactCard lang={lang} item={item} index={i} />)}
  </div>
  {!standalone && (
    <p class="more">
      <a class="btn btn--ghost misreg" href={lp(lang, '/artifacts')}>{t('artifacts.all')}</a>
    </p>
  )}
</section>

<style>
  .treasury {
    display: grid;
    gap: calc(var(--gutter) * 1.5);
  }
  @media (min-width: 640px) {
    .treasury {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 900px) {
    .treasury {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .more {
    margin-block-start: var(--space-l);
  }
</style>
