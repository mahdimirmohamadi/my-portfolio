---
/** Footer: links + a vim-style status line. */
import type { Lang } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { person } from '../../data/profile';
import Nix from '../art/Nix.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const file = Astro.url.pathname.replace(/^\/fa/, '').replace(/\/$/, '') || '/index';
---

<footer class="foot">
  <div class="foot__top wrap">
    <div class="foot__who">
      <Nix size={56} mood="sleep" bob={false} />
      <p>{t('footer.made')}</p>
    </div>
    <ul class="foot__links" role="list">
      {person.links.map((l) => <li><a href={l.href} rel="me noopener" target="_blank">{l.label}</a></li>)}
      <li><a href={`mailto:${person.email}`}>Email</a></li>
      <li><a href={lp(lang, '/blog')}>{t('nav.blog')}</a></li>
      <li><a href={lang === 'fa' ? '/fa/rss.xml' : '/rss.xml'}>RSS</a></li>
    </ul>
  </div>
  <div class="status mono" aria-hidden="true">
    <span class="status__mode">NORMAL</span>
    <span class="status__seg">⎇ main</span>
    <span class="status__seg status__file">~/site{file}.astro</span>
    <span class="status__fill"></span>
    <span class="status__seg">utf-8</span>
    <span class="status__seg">{lang}</span>
    <span class="status__seg status__end">© {new Date().getFullYear()}</span>
  </div>
</footer>

<style>
  .foot {
    margin-block-start: var(--space-2xl);
    border-block-start: 1.5px solid var(--edge-soft);
    background: var(--bg-2);
    /* room for the phone dock */
    padding-block-end: calc(86px + env(safe-area-inset-bottom));
  }
  @media (min-width: 1040px) {
    .foot {
      padding-block-end: 0;
    }
  }
  .foot__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding-block: var(--space-l);
  }
  .foot__who {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    color: var(--text-soft);
    font-size: var(--step--1);
  }
  .foot__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-s);
  }
  .foot__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--ff-mono);
    font-size: 0.85rem;
  }
  .status {
    display: flex;
    align-items: stretch;
    font-size: 0.72rem;
    border-block-start: 1.5px solid var(--edge-soft);
    background: var(--surface);
    color: var(--text-soft);
    direction: ltr;
    overflow: hidden;
    white-space: nowrap;
  }
  .status > span {
    padding: 0.4em 0.9em;
  }
  .status__mode {
    background: var(--lime);
    color: #0b0c09;
    font-weight: 600;
  }
  .status__seg {
    border-inline-end: 1px solid var(--edge-soft);
  }
  .status__fill {
    flex: 1;
  }
  .status__end {
    border: 0;
    background: var(--surface-2);
  }
  @media (max-width: 560px) {
    .status__file {
      display: none;
    }
  }
</style>
