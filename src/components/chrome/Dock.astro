---
/** Phones: a dock in thumb reach (the desktop uses the links in the top bar). */
import type { Lang } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { workspaces } from './workspaces';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const home = lp(lang, '/');
const items = workspaces.filter((w) => w.dock !== false);
---

<nav class="dock" aria-label={t('nav.menu')}>
  <ul role="list">
    {
      items.map((w) => (
        <li>
          <a href={w.path ? lp(lang, w.path) : `${home}#${w.hash}`} data-ws={w.hash ?? ''}>
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
              <path d={w.icon} fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
            </svg>
            <span>{t(w.key)}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  /* a cap in thumb reach */
  .dock {
    position: fixed;
    inset-inline: 10px;
    inset-block-end: calc(12px + env(safe-area-inset-bottom));
    z-index: 50;
    border: 1px solid var(--shell-skirt);
    border-radius: var(--radius);
    background: var(--shell-lift);
    box-shadow:
      inset 0 1px 0 var(--shell-rim),
      0 var(--skirt) 0 var(--shell-skirt);
  }
  .dock ul {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    list-style: none;
    padding: 0;
  }
  .dock a {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 3px;
    padding-block: 8px 7px;
    min-height: 56px;
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.75rem;
    -webkit-tap-highlight-color: transparent;
  }
  .dock a svg {
    transition: scale var(--dur-press) var(--ease-out);
  }
  .dock a:active svg {
    scale: 0.86;
  }
  .dock a:is(.is-active, [aria-current='page']) {
    color: var(--ink);
    font-weight: 600;
  }
  .dock a:is(.is-active, [aria-current='page'])::after {
    content: '';
    position: absolute;
    inset-block-start: 5px;
    inset-inline-end: calc(50% - 16px);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    border: 1.5px solid var(--ink);
  }
  @media (min-width: 900px) {
    .dock {
      display: none;
    }
  }
</style>
