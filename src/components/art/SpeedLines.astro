---
/** Radial speed lines (manga focus lines), generated deterministically at build time. */
interface Props {
  count?: number;
  class?: string;
  cx?: number;
  cy?: number;
}
const { count = 56, class: cls = '', cx = 50, cy = 50 } = Astro.props;

let seed = 1405;
const rand = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;

const lines = Array.from({ length: count }, (_, i) => {
  const a = (i / count) * Math.PI * 2 + rand() * 0.05;
  const inner = 30 + rand() * 16;
  const w = 0.35 + rand() * 1.1;
  const outer = 90;
  const p = (r: number, off = 0) => [cx + Math.cos(a + off) * r, cy + Math.sin(a + off) * r].map((v) => v.toFixed(2)).join(' ');
  // a thin wedge: sharp at the inside, wider at the edge
  return `M${p(inner)}L${p(outer, w * 0.012)}L${p(outer, -w * 0.012)}Z`;
});
---

<svg class:list={['speed-lines', cls]} viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
  <path d={lines.join('')} fill="currentColor" />
</svg>
