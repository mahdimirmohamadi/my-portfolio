---
/**
 * Nix, the CRT daemon. Raster poses cut from the owner's generated sheets by
 * scripts/nix.mjs (sheet 1) and scripts/nix-sheets.mjs (sheets 2-5).
 * `size` is the rendered width in px; the height follows each pose's own proportions.
 */
import { Image } from 'astro:assets';
import wave from '../../assets/nix/nix-wave.png';
import sleep from '../../assets/nix/nix-sleep.png';
import panic from '../../assets/nix/nix-panic.png';
import typing from '../../assets/nix/nix-type.png';
import head from '../../assets/nix/nix-head.png';
import call from '../../assets/nix/nix-call.png';
import mail from '../../assets/nix/nix-mail.png';
import cv from '../../assets/nix/nix-cv.png';
import grad from '../../assets/nix/nix-grad.png';
import thumbs from '../../assets/nix/nix-thumbs.png';
import tea from '../../assets/nix/nix-tea.png';
import music from '../../assets/nix/nix-music.png';
import search from '../../assets/nix/nix-search.png';
import point from '../../assets/nix/nix-point.png';
import think from '../../assets/nix/nix-think.png';
import bonsai from '../../assets/nix/nix-bonsai.png';
import desk from '../../assets/nix/nix-desk.png';
import plane from '../../assets/nix/nix-plane.png';
import phone from '../../assets/nix/nix-phone.png';
import notebook from '../../assets/nix/nix-notebook.png';
import hardhat from '../../assets/nix/nix-hardhat.png';
import bigkey from '../../assets/nix/nix-bigkey.png';
import moon from '../../assets/nix/nix-moon.png';
import sun from '../../assets/nix/nix-sun.png';
import rocket from '../../assets/nix/nix-rocket.png';
import windowPeek from '../../assets/nix/nix-window.png';
import bow from '../../assets/nix/nix-bow.png';
import bye from '../../assets/nix/nix-bye.png';

const poses = {
  happy: wave, sleep, panic, type: typing,
  head, call, mail, cv, grad, thumbs,
  tea, music, search, point, think, bonsai,
  desk, plane, phone, notebook, hardhat, bigkey,
  moon, sun, rocket, window: windowPeek, bow, bye,
};

interface Props {
  /** happy = waving */
  mood?: keyof typeof poses;
  size?: number;
  class?: string;
  /** an accessible name; omit when Nix is decoration */
  label?: string;
  eager?: boolean;
  /** legacy props from the SVG version, accepted and ignored */
  bob?: boolean;
  wave?: boolean;
}
const { mood = 'happy', size = 96, class: cls, label, eager = false } = Astro.props;
const src = poses[mood];
---

<Image
  class:list={['nix', `nix--${mood}`, cls]}
  src={src}
  width={size}
  widths={[size, size * 2]}
  sizes={`${size}px`}
  format="webp"
  quality={82}
  alt={label ?? ''}
  aria-hidden={label ? undefined : 'true'}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
/>

<style>
  .nix {
    display: block;
    flex: none;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }
  /* on glass or at night: a thin cut line, like a sticker's edge, so his black outline doesn't
     vanish into the dark. --nix-cut is transparent on the day shell (a no-op). */
  .nix {
    --nix-cut: transparent;
    filter: drop-shadow(1px 0 0 var(--nix-cut)) drop-shadow(-1px 0 0 var(--nix-cut)) drop-shadow(0 1px 0 var(--nix-cut)) drop-shadow(0 -1px 0 var(--nix-cut));
  }
  :global(.on-glass) .nix {
    --nix-cut: var(--on-glass-faint);
  }
  :global(:root[data-theme='dark']) .nix {
    --nix-cut: var(--rule-strong);
  }
</style>
