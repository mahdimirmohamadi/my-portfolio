---
/** Artifact emblems, hand-authored. Fixed print colours so they read in both editions. */
interface Props {
  kind: 'scroll' | 'orb' | 'lantern' | 'mirror' | 'coin';
  size?: number;
}
const { kind, size = 64 } = Astro.props;
---

<svg class="sigil" width={size} height={size} viewBox="0 0 64 64" aria-hidden="true">
  <g filter="url(#wobble)">
    {
      kind === 'scroll' && (
        <>
          <path class="paper" d="M14 14h32v36H14z" />
          <path class="saffron" d="M10 10h8v44h-8a4 4 0 0 1 0-8V18a4 4 0 0 1 0-8Z" />
          <path class="saffron" d="M42 10h8a4 4 0 0 1 0 8v28a4 4 0 0 1 0 8h-8Z" />
          <path class="line" d="M22 24h16M22 31h16M22 38h10" />
        </>
      )
    }
    {
      kind === 'orb' && (
        <>
          <circle class="paper" cx="24" cy="30" r="13" />
          <circle class="saffron" cx="40" cy="30" r="13" />
          <path class="line" d="M16 46h36l-4 8H20Z" />
          <path class="glint" d="M36 23a6 6 0 0 1 6-2" />
        </>
      )
    }
    {
      kind === 'lantern' && (
        <>
          <path class="line" d="M32 4v6M26 10h12" />
          <path class="pom" d="M22 14h20l4 8v18l-4 8H22l-4-8V22Z" />
          <path class="saffron" d="M26 24h12v14H26z" />
          <path class="line" d="M24 50h16v6H24z" />
        </>
      )
    }
    {
      kind === 'mirror' && (
        <>
          <ellipse class="saffron" cx="32" cy="26" rx="18" ry="20" />
          <ellipse class="paper" cx="32" cy="26" rx="12" ry="14" />
          <path class="line" d="M28 46h8l2 14h-12Z" />
          <path class="glint" d="M26 20a8 8 0 0 1 6-6" />
        </>
      )
    }
    {
      kind === 'coin' && (
        <>
          <circle class="saffron" cx="32" cy="32" r="22" />
          <circle class="line" cx="32" cy="32" r="15" />
          <path class="ink-fill" d="M32 21l3 7 7 1-5 5 1 7-6-3-6 3 1-7-5-5 7-1Z" />
        </>
      )
    }
  </g>
</svg>

<style>
  .sigil {
    flex: none;
    overflow: visible;
  }
  .sigil :is(path, circle, ellipse) {
    stroke: #16130f;
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .paper {
    fill: #f4ecda;
  }
  .saffron {
    fill: #f2b705;
  }
  .pom {
    fill: #b3261e;
  }
  .ink-fill {
    fill: #16130f;
  }
  .line,
  .glint {
    fill: none;
  }
  .glint {
    stroke: #f4ecda !important;
  }
</style>
