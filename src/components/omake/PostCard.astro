---
import type { Lang } from '../../i18n/ui';
import { useT, lp, formatDate, formatNum, readingMinutes } from '../../i18n/utils';
import { slugOf, tagSlug, type Post } from '../../lib/content';

interface Props {
  lang: Lang;
  post: Post;
  headingLevel?: 'h2' | 'h3';
}
const { lang, post, headingLevel: H = 'h3' } = Astro.props;
const t = useT(lang);
const slug = slugOf(post);
const href = lp(lang, `/omake/${slug}`);
---

<article class="post-card panel reveal">
  <p class="post-card__meta">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(lang, post.data.pubDate)}</time>
    <span class="sep" aria-hidden="true"></span>
    <span>{formatNum(lang, readingMinutes(post.body))} {t('omake.min')}</span>
    {post.data.draft && <span class="draft">DRAFT</span>}
  </p>
  <H class="post-card__title">
    <a href={href} class="post-card__link" style={`view-transition-name: post-${slug}`}>{post.data.title}</a>
  </H>
  <p class="post-card__desc">{post.data.description}</p>
  {
    post.data.tags.length > 0 && (
      <ul class="post-card__tags" role="list" aria-label={t('omake.tagged')}>
        {post.data.tags.map((tag) => (
          <li>
            <a class="tag misreg" href={lp(lang, `/omake/tags/${tagSlug(tag)}`)}>
              #{tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .post-card {
    display: grid;
    gap: var(--space-2xs);
  }
  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em;
    font-size: var(--step--1);
    color: var(--text-soft);
    font-weight: 600;
  }
  .draft {
    background: var(--pomegranate);
    color: var(--paper);
    padding-inline: 0.4em;
  }
  .post-card__title {
    font-size: var(--step-2);
  }
  .post-card__link {
    color: var(--text);
    text-decoration-color: var(--saffron);
    text-decoration-thickness: 4px;
    text-underline-offset: 0.18em;
  }
  .post-card__desc {
    color: var(--text-soft);
  }
  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6em;
    margin-block-start: var(--space-2xs);
  }
</style>
