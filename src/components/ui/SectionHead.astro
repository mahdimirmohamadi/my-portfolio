---
/** Section heading: the title carries its own weight; an optional one-line lead. */
interface Props {
  /** legacy: the old shell-prompt line (no longer rendered) */
  cmd?: string;
  path?: string;
  title: string;
  lead?: string;
  id?: string;
}
const { title, lead, id } = Astro.props;
---

<header class="sec-head">
  <h2 class="sec-head__title" id={id}>{title}</h2>
  {lead && <p class="sec-head__lead">{lead}</p>}
</header>
