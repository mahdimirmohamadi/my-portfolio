---
/** The arrow glyphs (drawn, 1.6 stroke): `next` for onward links, `out` for external ones.
    Parents mirror it in RTL via CSS. */
interface Props {
  size?: number;
  kind?: 'next' | 'out';
}
const { size = 16, kind = 'next' } = Astro.props;
---

<svg class="arrow" width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {kind === 'out' ? <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" /> : <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />}
</svg>
