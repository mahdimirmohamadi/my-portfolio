---
/** Manga sound-effect lettering. Decorative: hidden from screen readers. */
import type { Lang } from '../../i18n/ui';
interface Props {
  en: string;
  fa: string;
  lang: Lang;
  red?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { en, fa, lang, red, class: cls, ...rest } = Astro.props;
---

<span class:list={['sfx', { 'sfx--red': red }, cls]} aria-hidden="true" {...rest}>{lang === 'fa' ? fa : en}</span>
