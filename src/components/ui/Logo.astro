---
/** A tool's brand mark in currentColor, or nothing when it has none (the visible name carries the meaning). */
import { logoOf } from '../../data/logos';
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls } = Astro.props;
const logo = logoOf(name);
---

{
  logo && (
    <svg class:list={['logo', cls]} viewBox="0 0 24 24" width={size} height={size} aria-hidden="true">
      <path d={logo.path} fill="currentColor" />
    </svg>
  )
}

<style>
  .logo {
    flex: none;
  }
</style>
