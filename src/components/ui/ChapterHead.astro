---
interface Props {
  no: string;
  title: string;
  plain: string;
  id?: string;
}
const { no, title, plain, id } = Astro.props;
---

<header class="chapter-head reveal-rise">
  <span class="chapter-head__no misreg">{no}</span>
  <h2 class="chapter-head__title" id={id}>{title}</h2>
  <p class="chapter-head__plain">{plain}</p>
</header>
