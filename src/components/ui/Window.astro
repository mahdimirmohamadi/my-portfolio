---
/** An app window: traffic-light title bar + body. `shadow` picks the hard offset shadow colour. */
import type { HTMLTag } from 'astro/types';
interface Props {
  title: string;
  meta?: string;
  as?: HTMLTag;
  shadow?: 'ink' | 'lime' | 'amber' | 'coral';
  class?: string;
  bodyClass?: string;
  [key: string]: unknown;
}
const { title, meta, as: Tag = 'div', shadow = 'ink', class: cls, bodyClass, ...rest } = Astro.props;
---

<Tag class:list={['win', shadow !== 'ink' && `win--${shadow}`, cls]} {...rest}>
  <div class="win__bar">
    <span class="win__dots" aria-hidden="true"><span></span><span></span><span></span></span>
    <span class="win__title">{title}</span>
    {meta && <span class="win__meta">{meta}</span>}
  </div>
  <div class:list={['win__body', bodyClass]}>
    <slot />
  </div>
</Tag>
