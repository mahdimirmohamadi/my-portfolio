---
/** A framed panel with a quiet caption line. (`shadow` is accepted for old call sites and ignored.) */
import type { HTMLTag } from 'astro/types';
interface Props {
  title: string;
  meta?: string;
  as?: HTMLTag;
  shadow?: 'ink' | 'lime' | 'amber' | 'coral';
  class?: string;
  bodyClass?: string;
  [key: string]: unknown;
}
const { title, meta, as: Tag = 'div', shadow: _shadow, class: cls, bodyClass, ...rest } = Astro.props;
---

<Tag class:list={['win', cls]} {...rest}>
  <div class="win__bar">
    <span class="win__title">{title}</span>
    {meta && <span class="win__meta">{meta}</span>}
  </div>
  <div class:list={['win__body', bodyClass]}>
    <slot />
  </div>
</Tag>
