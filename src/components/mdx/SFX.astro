---
/** MDX: <SFX en="KA-BOOM" fa="بوم!" /> — a big sound effect between paragraphs. */
import Sfx from '../ui/SFX.astro';
interface Props {
  en: string;
  fa: string;
}
const { en, fa } = Astro.props;
const lang = Astro.currentLocale === 'fa' || Astro.url.pathname.startsWith('/fa') ? 'fa' : 'en';
---

<div class="mdx-sfx"><Sfx en={en} fa={fa} lang={lang} red /></div>

<style>
  .mdx-sfx {
    display: grid;
    place-items: center;
    padding-block: var(--space-m);
  }
</style>
