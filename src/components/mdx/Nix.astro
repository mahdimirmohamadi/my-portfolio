---
/** MDX: <Nix>…</Nix> — the mascot says something. */
import NixArt from '../art/Nix.astro';
---

<aside class="mdx-nix">
  <NixArt size={76} />
  <div class="mdx-nix__say"><slot /></div>
</aside>

<style>
  .mdx-nix {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-block: var(--space-l) !important;
  }
  .mdx-nix__say {
    position: relative;
    flex: 1;
    padding: var(--space-s) var(--space-m);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--plaster-lift);
  }
  .mdx-nix__say::before {
    content: '';
    position: absolute;
    inset-inline-start: -9px;
    inset-block-start: calc(50% - 8px);
    width: 14px;
    height: 14px;
    background: var(--plaster-lift);
    border-inline-start: 1px solid var(--rule-strong);
    border-block-end: 1px solid var(--rule-strong);
    rotate: calc(45deg * var(--dir));
  }
  :global(:root[dir='rtl']) .mdx-nix__say::before {
    rotate: -135deg;
  }
</style>
