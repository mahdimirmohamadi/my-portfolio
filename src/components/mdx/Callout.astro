---
/** MDX: <Callout title="Note">…</Callout> — a boxed aside with screentone. */
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="callout panel panel--flat tone tone--light">
  {title && <p class="callout__title">{title}</p>}
  <slot />
</aside>

<style>
  .callout__title {
    font-family: var(--ff-display);
    font-size: var(--step-1);
    margin-block-end: 0.3em;
  }
</style>
