---
/** MDX: <Callout title="Tip">…</Callout> */
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="callout">
  {title && <p class="callout__title"><span class="sticker sticker--amber">{title}</span></p>}
  <div class="callout__body"><slot /></div>
</aside>

<style>
  .callout {
    padding: var(--space-m);
    border: var(--bw) solid var(--edge);
    border-radius: var(--radius);
    background: var(--surface-2);
    box-shadow: var(--shadow-amber);
  }
  .callout__title {
    margin-block-end: var(--space-xs);
  }
</style>
