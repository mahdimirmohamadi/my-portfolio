---
/** MDX: <Callout title="Tip">…</Callout> */
interface Props {
  title?: string;
}
const { title } = Astro.props;
---

<aside class="callout">
  {title && <p class="callout__title"><span class="sticker sticker--amber">{title}</span></p>}
  <div class="callout__body"><slot /></div>
</aside>

<style>
  /* a cap in the prose */
  .callout {
    padding: var(--space-m);
    border: 1px solid var(--shell-skirt);
    border-radius: var(--radius);
    background: var(--shell-lift);
    box-shadow:
      inset 0 1px 0 var(--shell-rim),
      0 var(--skirt) 0 var(--shell-skirt);
  }
  .callout__title {
    margin-block-end: var(--space-xs);
  }
</style>
