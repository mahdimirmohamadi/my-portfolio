---
/**
 * A project. With a screenshot it's a framed print beside its note;
 * without one it's a single index line.
 */
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { slugOf, type Project } from '../../lib/content';
import { shotOf } from '../../lib/shots';
import Arrow from '../ui/Arrow.astro';

interface Props {
  lang: Lang;
  item: Project;
}
const { lang, item } = Astro.props;
const t = useT(lang);
const slug = slugOf(item);
const href = lp(lang, `/projects/${slug}`);
const host = item.data.url ? new URL(item.data.url).host : null;
const shot = shotOf(slug);
---

{
  shot ? (
    <article class="proj">
      <a class="proj__print" href={href} tabindex="-1" aria-hidden="true">
        <Image src={shot} widths={[480, 800]} sizes="(min-width: 900px) 460px, 100vw" format="webp" quality={72} alt="" loading="lazy" />
      </a>
      <div class="proj__note">
        <h3 class="proj__title">
          <a href={href} style={`view-transition-name: proj-${slug}`}>
            {item.data.title}
          </a>
        </h3>
        <p class="proj__summary">{item.data.summary}</p>
        <p class="proj__stack">{item.data.kind} · {item.data.stack.slice(0, 4).join(', ')}</p>
        <p class="proj__links">
          <a class="arrow-link" href={href}>
            {t('projects.read')}
            <Arrow />
          </a>
          {host && (
            <a class="proj__ext" href={item.data.url} target="_blank" rel="noopener">
              {host}
              <Arrow kind="out" size={13} />
            </a>
          )}
        </p>
      </div>
    </article>
  ) : (
    <article class="line">
      <h3 class="line__title">
        <a href={href} style={`view-transition-name: proj-${slug}`}>
          {item.data.title}
        </a>
      </h3>
      <p class="line__summary">{item.data.summary}</p>
      <p class="line__kind caption">{item.data.kind}</p>
    </article>
  )
}

<style>
  .proj {
    display: grid;
    gap: var(--space-m);
    align-items: center;
  }
  /* side by side only when the slot is wide (the lead project); otherwise print above note */
  @container prints (min-width: 760px) {
    .proj {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }
  .proj__print {
    display: block;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--plaster-deep);
  }
  .proj__print :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    transition: scale 700ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .proj:hover .proj__print :global(img) {
      scale: 1.025;
    }
  }
  .proj__title {
    font-size: var(--step-2);
  }
  .proj__title a,
  .line__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .proj__title a:hover,
  .line__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--lime-ink);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .proj__summary {
    margin-block-start: var(--space-xs);
    color: var(--ink-soft);
    max-width: 48ch;
  }
  .proj__stack {
    margin-block-start: var(--space-xs);
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
  .proj__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-m);
    margin-block-start: var(--space-xs);
  }
  .proj__ext {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 44px;
    font-size: 0.88rem;
    color: var(--ink-faint);
    text-decoration-color: var(--rule);
  }
  .proj__ext:hover {
    color: var(--ink);
  }
  :global(:root[dir='rtl']) .proj__ext :global(svg) {
    scale: -1 1;
  }

  .line {
    display: grid;
    gap: 0.2rem var(--space-m);
    padding-block: var(--space-s);
    border-block-start: 1px solid var(--rule);
  }
  @media (min-width: 760px) {
    .line {
      grid-template-columns: 14rem minmax(0, 1fr) auto;
      align-items: baseline;
    }
  }
  .line__title {
    font-size: var(--step-1);
  }
  .line__summary {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
</style>
