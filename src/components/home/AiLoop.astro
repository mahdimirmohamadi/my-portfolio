---
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { aiBuilt, aiTools } from '../../data/profile';
import SectionHead from '../ui/SectionHead.astro';
import Window from '../ui/Window.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

// an illustrative agent session (the shape of the loop, not a real transcript)
type L = { k: 'prompt' | 'step' | 'out' | 'add' | 'del' | 'ok' | 'note'; s: string };
const session: L[] = [
  { k: 'prompt', s: 'make the product page load faster on mobile' },
  { k: 'step', s: 'Plan' },
  { k: 'out', s: '1. measure LCP on /products/[slug] (Lighthouse, mobile)' },
  { k: 'out', s: '2. preload the hero image, lazy-load the rest' },
  { k: 'out', s: '3. move the reviews widget into its own chunk' },
  { k: 'step', s: 'Edit  app/products/[slug]/page.tsx' },
  { k: 'del', s: "import Reviews from '@/components/Reviews'" },
  { k: 'add', s: "const Reviews = dynamic(() => import('@/components/Reviews'))" },
  { k: 'add', s: '<Image src={hero} priority sizes="100vw" alt={title} />' },
  { k: 'step', s: 'Run   pnpm test && pnpm lighthouse --mobile' },
  { k: 'ok', s: 'tests pass · LCP down · CLS 0' },
  { k: 'note', s: 'I read every line of the diff, adjust, then commit.' },
];
---

<section class="section wrap" id="ai" aria-labelledby="ai-title">
  <SectionHead cmd="cat ~/ai/README.md" path="~/ai" title={t('ai.title')} lead={t('ai.lead')} id="ai-title" />
  <div class="ai">
    <Window title="agent session — ~/shop" meta="illustrative" shadow="lime" class="session rise" data-session>
      <ol class="session__log mono" role="list" aria-label="Illustrative AI pair-programming session">
        {
          session.map((l) => (
            <li class:list={['sl', `sl--${l.k}`]} data-line>
              {l.k === 'prompt' && <span class="sl__ps">›</span>}
              {l.k === 'step' && <span class="sl__dot" aria-hidden="true">●</span>}
              {l.k === 'add' && <span class="sl__sign">+</span>}
              {l.k === 'del' && <span class="sl__sign">−</span>}
              {l.k === 'ok' && <span class="sl__sign">✓</span>}
              <span class="sl__text">{l.s}</span>
            </li>
          ))
        }
      </ol>
      <button type="button" class="chip session__replay" data-session-replay>↻ {t('ai.replay')}</button>
    </Window>

    <div class="ai__side">
      <div class="panel-card rise">
        <h3 class="panel-card__title">{t('ai.built')}</h3>
        <ul class="built" role="list">
          {
            aiBuilt.map((b) => (
              <li>
                <p class="built__title">{b.title[lang]}</p>
                <p class="built__body">{b.body[lang]}</p>
                <p class="built__where mono">@ {b.where}</p>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="panel-card rise">
        <h3 class="panel-card__title">{t('ai.tools')}</h3>
        <ul class="tools" role="list">
          {
            aiTools.map((tool, i) => (
              <li class="sticker" style={`--tilt:${[-2, 1.5, -1, 2.5][i]}deg`}>
                {tool}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/session';
</script>

<style>
  .ai {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 1000px) {
    .ai {
      grid-template-columns: 1.35fr 1fr;
      align-items: start;
    }
  }
  :global(.session .win__body) {
    position: relative;
    background: var(--bg-2);
    padding: var(--space-m);
  }
  .session__log {
    display: grid;
    gap: 0.15rem;
    font-size: 0.84rem;
    line-height: 1.6;
    direction: ltr;
    text-align: left;
    min-height: 23rem;
  }
  .sl {
    display: flex;
    gap: 0.6ch;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--text-soft);
  }
  .sl--prompt {
    color: var(--text);
    font-weight: 600;
    margin-block-end: 0.4rem;
  }
  .sl__ps {
    color: var(--lime-ink);
  }
  .sl--step {
    color: var(--text);
    margin-block-start: 0.5rem;
  }
  .sl__dot {
    color: var(--amber);
  }
  .sl--out {
    padding-inline-start: 2ch;
  }
  .sl--add,
  .sl--del {
    padding-inline: 0.5ch;
    border-radius: 4px;
  }
  .sl--add {
    background: color-mix(in srgb, var(--lime) 14%, transparent);
    color: var(--text);
  }
  .sl--del {
    background: color-mix(in srgb, var(--coral) 16%, transparent);
    color: var(--text);
    text-decoration: line-through;
    text-decoration-color: color-mix(in srgb, var(--coral) 60%, transparent);
  }
  .sl__sign {
    font-weight: 700;
    text-decoration: none;
  }
  .sl--add .sl__sign,
  .sl--ok {
    color: var(--lime-ink);
  }
  .sl--del .sl__sign {
    color: var(--coral);
  }
  .sl--ok {
    font-weight: 600;
    padding-inline-start: 2ch;
  }
  .sl--note {
    margin-block-start: 0.6rem;
    color: var(--text-faint);
    font-style: italic;
  }
  .session__replay {
    position: absolute;
    inset-block-end: var(--space-s);
    inset-inline-end: var(--space-s);
    cursor: pointer;
  }
  .ai__side {
    display: grid;
    gap: var(--space-m);
  }
  .panel-card {
    padding: var(--space-m);
    border: var(--bw) solid var(--edge);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .panel-card__title {
    font-size: var(--step-1);
    margin-block-end: var(--space-s);
  }
  .built {
    display: grid;
    gap: var(--space-s);
  }
  .built li + li {
    padding-block-start: var(--space-s);
    border-block-start: 1.5px dashed var(--edge-soft);
  }
  .built__title {
    font-weight: 600;
  }
  .built__body {
    color: var(--text-soft);
    font-size: 0.95rem;
  }
  .built__where {
    font-size: 0.78rem;
    color: var(--lime-ink);
    direction: ltr;
    text-align: start;
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }
</style>
