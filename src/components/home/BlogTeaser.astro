---
import type { Lang } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { getPosts } from '../../lib/content';
import SectionHead from '../ui/SectionHead.astro';
import PostRow from '../blog/PostRow.astro';
import Arrow from '../ui/Arrow.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const posts = (await getPosts(lang)).slice(0, 3);
---

<section class="section wrap" id="blog" aria-labelledby="blog-title">
  <SectionHead title={t('blog.title')} lead={t('blog.lead')} id="blog-title" />
  {
    posts.length ? (
      <div class="list">
        {posts.map((post) => (
          <PostRow lang={lang} post={post} />
        ))}
      </div>
    ) : (
      <p class="empty">{t('blog.empty')}</p>
    )
  }
  <p class="more">
    <a class="arrow-link" href={lp(lang, '/blog')}>
      {t('blog.all')}
      <Arrow />
    </a>
  </p>
</section>

<style>
  .list {
    border-block-end: 1px solid var(--rule);
  }
  .more {
    margin-block-start: var(--space-m);
  }
</style>
