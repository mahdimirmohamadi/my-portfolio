---
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { procs } from '../../data/profile';
import SectionHead from '../ui/SectionHead.astro';
import Window from '../ui/Window.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const cores = [0.62, 0.38, 0.81, 0.47];
---

<section class="section wrap" id="skills" aria-labelledby="skills-title">
  <SectionHead cmd="htop --user=mahdi" title={t('skills.title')} lead={t('skills.lead')} id="skills-title" />
  <Window title="htop" meta="tasks: 7 · load: curious" shadow="amber" class="htop rise" data-idle>
    <div class="meters mono" aria-hidden="true">
      {
        cores.map((c, i) => (
          <div class="meter">
            <span class="meter__n">{i}</span>
            <span class="meter__bar">
              <span class="meter__fill" style={`--v:${c};--d:${3 + i * 0.7}s`} />
            </span>
          </div>
        ))
      }
      <div class="meter meter--wide">
        <span class="meter__n">Uptime</span>
        <span class="meter__val">4y · since 2022</span>
      </div>
    </div>
    <div class="procs" role="table" aria-label={t('skills.title')}>
      <div class="procs__head mono" role="row">
        <span role="columnheader">PID</span>
        <span role="columnheader">USER</span>
        <span role="columnheader">CPU%</span>
        <span role="columnheader">COMMAND</span>
      </div>
      {
        procs.map((p, i) => (
          <div class="proc" role="row">
            <span class="proc__pid mono" role="cell">{p.pid}</span>
            <span class="proc__user mono" role="cell">mahdi</span>
            <span class="proc__cpu" role="cell" aria-hidden="true">
              <span class="proc__bar" style={`--v:${p.load / 100};--d:${2.6 + i * 0.45}s`} />
            </span>
            <span class="proc__cmd" role="cell">
              <b class="mono">{p.cmd}</b> <span class="proc__label">— {p.label[lang]}</span>
              <span class="proc__tools">
                {p.tools.map((tool) => (
                  <span class="chip">{tool}</span>
                ))}
              </span>
            </span>
          </div>
        ))
      }
    </div>
  </Window>
</section>

<style>
  :global(.htop .win__body) {
    background: var(--bg-2);
    display: grid;
    gap: var(--space-m);
  }
  .meters {
    display: grid;
    gap: 0.3rem var(--space-m);
    font-size: 0.78rem;
    direction: ltr;
  }
  @media (min-width: 700px) {
    .meters {
      grid-template-columns: 1fr 1fr;
    }
  }
  .meter {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .meter__n {
    color: var(--amber);
    min-width: 1ch;
  }
  :global(:root[data-theme='light']) .meter__n {
    color: #9a5b00;
  }
  .meter__bar {
    flex: 1;
    height: 12px;
    border: 1.5px solid var(--edge-soft);
    border-radius: 4px;
    overflow: hidden;
  }
  .meter__fill,
  .proc__bar {
    display: block;
    height: 100%;
    background: var(--lime);
    transform-origin: left;
    scale: var(--v) 1;
  }
  .meter__val {
    color: var(--text-soft);
  }
  .procs {
    display: grid;
    font-size: 0.92rem;
  }
  .procs__head,
  .proc {
    display: grid;
    grid-template-columns: 3.4rem 3.6rem 4.5rem 1fr;
    gap: var(--space-s);
    align-items: start;
    padding-block: 0.55rem;
  }
  .procs__head {
    background: var(--lime);
    color: #0b0c09;
    font-size: 0.74rem;
    font-weight: 600;
    padding-inline: 0.5rem;
    border-radius: 6px;
    direction: ltr;
  }
  .proc {
    padding-inline: 0.5rem;
    border-block-end: 1px dashed var(--edge-soft);
  }
  .proc__pid,
  .proc__user {
    color: var(--text-faint);
    font-size: 0.8rem;
    padding-block-start: 0.15em;
    direction: ltr;
  }
  .proc__cpu {
    height: 10px;
    margin-block-start: 0.45em;
    border: 1.5px solid var(--edge-soft);
    border-radius: 4px;
    overflow: hidden;
  }
  .proc__cmd b {
    color: var(--lime-ink);
    font-weight: 600;
  }
  .proc__label {
    color: var(--text-soft);
  }
  .proc__tools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-block-start: 0.4rem;
  }
  @media (max-width: 620px) {
    .procs__head {
      display: none;
    }
    .proc {
      grid-template-columns: 3.6rem 1fr;
    }
    .proc__pid,
    .proc__user {
      display: none;
    }
  }
  /* bars wiggle like a live process list (decorative; paused off-screen) */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-lite])) .meter__fill,
    :global(html:not([data-lite])) .proc__bar {
      animation: load var(--d) var(--ease-in-out) infinite alternate;
    }
  }
  :global([data-offscreen]) :is(.meter__fill, .proc__bar) {
    animation-play-state: paused;
  }
  @keyframes load {
    from {
      scale: calc(var(--v) * 0.82) 1;
    }
    to {
      scale: min(1, calc(var(--v) * 1.08)) 1;
    }
  }
</style>
