---
/**
 * The first screen. Who I am and how to reach me on the open side (phone and email are the
 * point); on the other side my story as a git tree that grows on arrival: git init when I was
 * born, a branch for Mechatronics that merges back when I graduated, a branch off it for Armani
 * English, a branch for InnoLearn. Every commit message is a link to that part of Experience;
 * hovering one lights its branch. The tree grows up into my portrait: that's me, now. Nix stands
 * still in the corner beside it.
 */
import { Image } from 'astro:assets';
import type { Lang, UIKey } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { person } from '../../data/profile';
import Arrow from '../ui/Arrow.astro';
import Icon from '../ui/Icon.astro';
import Nix from '../art/Nix.astro';
import original from '../../assets/photo/mahdi-original.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

// ── the tree ──
// lanes (x): main, innolearn, mechatronics, armani-english. Rows (y): newest on top, like `git log --graph`.
// Wide screens get roomy lanes and 72px rows; phones get tighter lanes and taller rows, so the
// wrapped commit messages still sit beside their own node.
type Branch = 'main' | 'inno' | 'mech' | 'armani';
const TOP = 40;
function geometry(X: Record<Branch, number>, row: number, bend: number) {
  const y = (r: number) => TOP + r * row;
  const W = X.armani + 34;
  const H = y(5) + 48;
  // each branch is drawn from where it starts toward its tip, so the tree grows in time order
  const paths: Record<Branch, string> = {
    main: `M${X.main} ${y(5)} L${X.main} ${y(0)}`,
    mech: `M${X.main} ${y(5)} C${X.main} ${y(5) - bend} ${X.mech} ${y(4) + bend} ${X.mech} ${y(4)} L${X.mech} ${y(3) - 8} C${X.mech} ${y(2) + bend * 0.8} ${X.main} ${y(2) + bend} ${X.main} ${y(2)}`,
    armani: `M${X.mech} ${y(4)} C${X.mech} ${y(4) - bend} ${X.armani} ${y(3) + bend} ${X.armani} ${y(3)} L${X.armani} ${y(0)}`,
    inno: `M${X.main} ${y(2)} C${X.main} ${y(2) - bend} ${X.inno} ${y(1) + bend} ${X.inno} ${y(1)} L${X.inno} ${y(0)}`,
  };
  // the commits: kind, where, and the beat they appear at
  const nodes: { kind: 'root' | 'commit' | 'merge' | 'tip'; x: number; y: number; at: number }[] = [
    { kind: 'root', x: X.main, y: y(5), at: 150 },
    { kind: 'commit', x: X.mech, y: y(4), at: 750 },
    { kind: 'commit', x: X.armani, y: y(3), at: 1100 },
    { kind: 'merge', x: X.main, y: y(2), at: 1360 },
    { kind: 'commit', x: X.inno, y: y(1), at: 1580 },
    { kind: 'tip', x: X.armani, y: y(0), at: 1750 },
    { kind: 'tip', x: X.inno, y: y(0), at: 1800 },
    { kind: 'tip', x: X.main, y: y(0), at: 1950 },
  ];
  return { X, row, W, H, y, paths, nodes };
}
const trees = [
  { id: 'wide', ...geometry({ main: 30, inno: 72, mech: 114, armani: 156 }, 80, 38) },
  { id: 'phone', ...geometry({ main: 22, inno: 50, mech: 78, armani: 106 }, 112, 46) },
];
const [wide, phone] = trees;
// line timing (ms): when each branch starts growing and for how long
const grow: Record<Branch, readonly [number, number]> = { main: [250, 1700], mech: [450, 900], armani: [850, 900], inno: [1360, 440] };
const branches: Branch[] = ['main', 'mech', 'armani', 'inno'];
// the log beside it, one row per tree row
const rows: { key: string; branch?: Branch; href?: string; at: number }[] = [
  { key: 'refs', at: 1950 },
  { key: 'inno', branch: 'inno', href: '#work-innolearn', at: 1580 },
  { key: 'merge', branch: 'mech', href: '#work-school', at: 1360 },
  { key: 'armani', branch: 'armani', href: '#work-armani', at: 1100 },
  { key: 'mech', branch: 'mech', href: '#work-school', at: 750 },
  { key: 'born', branch: 'main', href: '#work', at: 150 },
];
// the living branches carry a commit up to their tip, now and then
const pulses: { branch: Branch; begin: number; dur: number }[] = [
  { branch: 'main', begin: 2.6, dur: 4.6 },
  { branch: 'armani', begin: 3.3, dur: 3.8 },
  { branch: 'inno', begin: 4.1, dur: 2.6 },
];
---

<section class="hero" id="top" aria-labelledby="hero-title" data-hero>
  <!-- a second look in the same session skips the growth: the tree is already there -->
  <script is:inline>
    try {
      if (sessionStorage.getItem('tree-grown')) document.currentScript.parentElement.dataset.seen = '';
      sessionStorage.setItem('tree-grown', '1');
    } catch {}
  </script>
  <div class="hero__inner">
    <div class="copy">
      <h1 class="copy__title" id="hero-title" style="--n:0">{t('hero.title')}</h1>
      <p class="copy__lead" style="--n:1">{t('hero.lead')}</p>
      <div class="copy__actions" style="--n:2">
        <a class="btn" href="#work">
          {t('hero.work')}
          <Arrow />
        </a>
        <a class="btn btn--ghost" href={lp(lang, '/blog')}>
          {t('hero.blog')}
        </a>
      </div>
      <ul class="reach" role="list" aria-label={t('hero.reach')} style="--n:3">
        <li>
          <a href={`tel:${person.phone.tel}`}>
            <Icon name="phone" size={20} />
            <span class="reach__label">{t('contact.phone.label')}</span>
            <span class="reach__val" dir="ltr">{person.phone.display[lang]}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${person.email}`}>
            <Icon name="mail" size={20} />
            <span class="reach__label">{t('contact.email.label')}</span>
            <span class="reach__val" dir="ltr">{person.email}</span>
          </a>
        </li>
      </ul>
      <a class="resume-btn btn btn--ghost" href={person.resume[lang]} download data-resume style="--n:4">
        <Icon name="download" size={22} />
        <span>{t('hero.resume')}</span>
        <span class="resume-btn__meta">EN · FA</span>
      </a>
    </div>

    <div class="stage">
      <Nix mood="happy" size={116} class="hero__nix" />
      <figure
        class="tree"
        style={`--top:${TOP}px; --row-wide:${wide.row}px; --h-wide:${wide.H}px; --w-wide:${wide.W}px; --main-wide:${wide.X.main}px; --row-phone:${phone.row}px; --h-phone:${phone.H}px; --w-phone:${phone.W}px; --main-phone:${phone.X.main}px`}
      >
        <!-- me, now: the photo sits on HEAD -->
        <span class="tree__me">
          <Image class="tree__me-img" src={original} width={320} height={320} widths={[260, 320, 640]} sizes="(max-width: 480px) 260px, 320px" format="webp" quality={82} alt={t('whoami.photo.real.alt')} loading="eager" fetchpriority="high" />
        </span>

        {
          trees.map((g) => (
            <svg class={`tree__svg tree__svg--${g.id}`} viewBox={`0 0 ${g.W} ${g.H}`} width={g.W} height={g.H} role="img" aria-label={t('hero.tree.label')} data-tree-svg>
              <g class="lines" fill="none" stroke-linecap="round" stroke-linejoin="round">
                {branches.map((b) => (
                  <path class={`line line--${b}`} pathLength="1" d={g.paths[b]} style={`--start:${grow[b][0]}ms; --dur:${grow[b][1]}ms`} />
                ))}
                {branches.map((b) => (
                  <path class={`lit lit--${b}`} d={g.paths[b]} />
                ))}
              </g>
              <g class="pulses" aria-hidden="true">
                {pulses.map((p) => (
                  <circle class="pulse" r="4" opacity="0">
                    <animateMotion dur={`${p.dur}s`} begin={`${p.begin}s`} repeatCount="indefinite" path={g.paths[p.branch]} />
                    <animate attributeName="opacity" values="0;1;1;0" keyTimes="0;0.12;0.85;1" dur={`${p.dur}s`} begin={`${p.begin}s`} repeatCount="indefinite" />
                  </circle>
                ))}
              </g>
              {g.nodes.map((n) =>
                n.kind === 'root' ? (
                  <g class="node node--root" style={`--at:${n.at}ms`}>
                    <circle class="root__ring" cx={n.x} cy={n.y} r="12" />
                    <circle class="root__dot" cx={n.x} cy={n.y} r="6" />
                  </g>
                ) : n.kind === 'tip' ? (
                  <g class="node node--tip" style={`--at:${n.at}ms`}>
                    <circle class="tip__halo" cx={n.x} cy={n.y} r="15" />
                    <circle class="tip__dot" cx={n.x} cy={n.y} r="8" />
                  </g>
                ) : n.kind === 'merge' ? (
                  <g class="node node--merge" style={`--at:${n.at}ms`}>
                    <circle class="merge__ring" cx={n.x} cy={n.y} r="10" />
                    <circle class="commit" cx={n.x} cy={n.y} r="5" />
                  </g>
                ) : (
                  <circle class="node commit" style={`--at:${n.at}ms`} cx={n.x} cy={n.y} r="6" />
                ),
              )}
            </svg>
          ))
        }

        <ol class="log" role="list">
          {
            rows.map((r) =>
              r.href ? (
                <li class={`log__row log__row--${r.key}`} style={`--at:${r.at + 100}ms`}>
                  <a href={r.href} data-b={r.branch}>
                    <span class="log__msg" dir="auto">
                      {t(`hero.tree.${r.key}` as UIKey)}
                    </span>
                    <span class="log__cmd" dir="ltr">
                      {t(`hero.tree.${r.key}.cmd` as UIKey)}
                    </span>
                  </a>
                </li>
              ) : (
                <li class="log__row log__row--refs" style={`--at:${r.at + 100}ms`}>
                  <span class="log__refs" dir="ltr">
                    {t('hero.tree.refs')}
                  </span>
                </li>
              ),
            )
          }
        </ol>
      </figure>
    </div>
  </div>
  <div class="desk-edge" aria-hidden="true"></div>
</section>

<script>
  import { prefersLessMotion } from '../../scripts/util';

  // the commits flowing up the tree are SMIL: hold them when there is less motion, and while off-screen
  // (the tree drawn for the other screen size is display:none, so it never intersects and stays paused)
  document.addEventListener('astro:page-load', () => {
    const svgs = [...document.querySelectorAll<SVGSVGElement>('[data-tree-svg]')].filter((s) => !s.dataset.ready);
    if (!svgs.length) return;
    svgs.forEach((s) => (s.dataset.ready = ''));
    if (prefersLessMotion()) return svgs.forEach((s) => s.pauseAnimations());
    const io = new IntersectionObserver((entries) =>
      entries.forEach((e) => {
        const s = e.target as SVGSVGElement;
        if (e.isIntersecting) s.unpauseAnimations();
        else s.pauseAnimations();
      }),
    );
    svgs.forEach((s) => io.observe(s));
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>

<style>
  .hero {
    position: relative;
    overflow-x: clip;
  }
  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    padding: var(--space-l) var(--page-gutter) var(--space-xl);
    max-width: calc(var(--page-max) + 2 * var(--page-gutter));
    margin-inline: auto;
  }
  @media (min-width: 1000px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) minmax(460px, 560px);
      align-items: center;
      gap: var(--space-2xl);
      min-height: min(calc(100svh - 74px), 880px);
      padding-block: var(--space-l);
    }
  }

  /* ── the open side ── */
  .copy__title {
    font-size: clamp(2.5rem, 1.5rem + 3vw, 4.4rem);
    line-height: 1;
    max-width: 12ch;
  }
  :global(:root[dir='rtl']) .copy__title {
    font-size: clamp(2.1rem, 1.3rem + 2.6vw, 3.6rem);
    max-width: 16ch;
  }
  .copy__lead {
    margin-block-start: var(--space-m);
    max-width: 58ch;
    font-size: var(--step-0);
    color: var(--ink-soft);
  }
  .copy__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }

  /* phone + email: set as plainly as a business card, never hidden behind a click */
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-l);
    margin-block-start: var(--space-m);
    padding: 0;
    list-style: none;
  }
  .reach a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 48px;
    color: var(--ink);
    text-decoration: none;
  }
  .reach a :global(.icon) {
    color: var(--ink-soft);
  }
  .reach__label {
    font-size: 0.82rem;
    color: var(--ink-faint);
  }
  .reach__val {
    font-weight: 600;
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    unicode-bidi: isolate;
    text-decoration: underline;
    text-decoration-color: var(--shell-skirt);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .reach a:hover .reach__val {
    text-decoration-color: var(--lime-ink);
  }
  @media (max-width: 480px) {
    .reach__val {
      font-size: 0.98rem;
      overflow-wrap: anywhere;
    }
  }

  /* the resume: a wide key that opens the EN/FA picker */
  .resume-btn {
    gap: 0.75rem;
    min-height: 58px;
    margin-block-start: var(--space-m);
    padding-inline: 1.4rem;
    font-size: 1.05rem;
  }
  .resume-btn__meta {
    font-family: var(--ff-mono);
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--ink-faint);
  }
  .resume-btn :global(.icon) {
    transition: translate var(--dur-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .resume-btn:hover :global(.icon) {
      translate: 0 2px;
    }
  }

  /* ── the stage ── */
  .stage {
    /* the portrait gives way a little on short screens so the whole tree stays in the fold */
    --me-h: clamp(232px, 32svh, 300px);
    --me-w: calc(var(--me-h) * 0.83);
    --c-main: oklch(0.62 0.03 120);
    --c-mech: oklch(0.6 0.08 45);
    --c-armani: oklch(0.6 0.07 80);
    --c-inno: oklch(0.55 0.07 160);
    position: relative;
    justify-self: center;
    width: min(100%, 560px);
    /* room above HEAD for the photo */
    /* the portrait's height, less the 40px above HEAD, plus its 18px gap */
    padding-block-start: calc(var(--me-h) - 22px);
  }
  :global(:root[data-theme='dark']) .stage {
    --c-main: oklch(0.62 0.03 250);
    --c-mech: oklch(0.7 0.09 45);
    --c-armani: oklch(0.7 0.07 80);
    --c-inno: oklch(0.66 0.08 160);
  }
  @media (min-width: 1000px) {
    .stage {
      justify-self: end;
    }
  }
  @media (max-width: 480px) {
    .stage {
      --me-w: min(240px, 62vw);
      --me-h: min(290px, 75vw);
    }
  }
  /* a soft field behind the tree, like light from a screen */
  .stage::before {
    content: '';
    position: absolute;
    inset: 12% -10% -4% -10%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, oklch(0.905 0.2 124 / 0.14), transparent 72%);
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .stage::before {
    background: radial-gradient(closest-side, oklch(0.4 0.09 262 / 0.5), transparent 72%);
  }

  /* the tree: lanes on the inline-start, the log beside them */
  .tree {
    --row: var(--row-wide);
    --h: var(--h-wide);
    --w: var(--w-wide);
    --main: var(--main-wide);
    position: relative;
    display: grid;
    grid-template-columns: var(--w) minmax(0, 1fr);
    margin: 0;
    height: var(--h);
  }
  .tree .tree__svg--phone {
    display: none;
  }
  @media (max-width: 480px) {
    .tree {
      --row: var(--row-phone);
      --h: var(--h-phone);
      --w: var(--w-phone);
      --main: var(--main-phone);
      padding-inline-start: 10px;
    }
    .tree .tree__svg--wide {
      display: none;
    }
    .tree .tree__svg--phone {
      display: block;
    }
  }
  /* the lanes keep their exact pitch at every width (base.css shrinks svgs by default) */
  .tree__svg {
    display: block;
    width: var(--w);
    max-width: none;
    height: var(--h);
    overflow: visible;
    /* the lanes read from the inline-start in both directions */
    transform: scaleX(var(--dir));
  }
  .line {
    stroke-width: 3;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: opacity var(--dur-ui) var(--ease-out);
  }
  .line--main {
    stroke: var(--c-main);
  }
  .line--mech {
    stroke: var(--c-mech);
  }
  .line--armani {
    stroke: var(--c-armani);
  }
  .line--inno {
    stroke: var(--c-inno);
  }
  /* the lit copy of each branch, shown while its commit is hovered */
  .lit {
    stroke: var(--lime-ink);
    stroke-width: 4;
    opacity: 0;
    transition: opacity var(--dur-ui) var(--ease-out);
  }
  .node {
    transform-box: fill-box;
    transform-origin: center;
  }
  .commit {
    fill: var(--shell);
    stroke: var(--rule-strong);
    stroke-width: 2.5;
  }
  .merge__ring {
    fill: var(--shell);
    stroke: var(--rule-strong);
    stroke-width: 2;
  }
  .tip__dot {
    fill: var(--lime);
    stroke: var(--ink);
    stroke-width: 2;
  }
  .tip__halo {
    fill: var(--lime);
    opacity: 0.22;
  }
  /* the root commit: a plain ring around an ink dot */
  .root__ring {
    fill: var(--shell);
    stroke: var(--rule-strong);
    stroke-width: 2;
  }
  .root__dot {
    fill: var(--rule-strong);
  }
  .pulse {
    fill: var(--lime);
    stroke: var(--ink);
    stroke-width: 1.5;
  }

  /* hover a commit: its branch lights up, the rest steps back */
  .tree:has(.log a:is(:hover, :focus-visible)) .line {
    opacity: 0.28;
  }
  .tree:has(a[data-b='main']:is(:hover, :focus-visible)) :is(.line--main, .lit--main),
  .tree:has(a[data-b='mech']:is(:hover, :focus-visible)) :is(.line--mech, .lit--mech),
  .tree:has(a[data-b='armani']:is(:hover, :focus-visible)) :is(.line--armani, .lit--armani),
  .tree:has(a[data-b='inno']:is(:hover, :focus-visible)) :is(.line--inno, .lit--inno) {
    opacity: 1;
  }
  .log:has(a:is(:hover, :focus-visible)) .log__row:not(:has(a:is(:hover, :focus-visible))) {
    opacity: 0.5;
  }

  /* the log: one row per commit, aligned to its node */
  .log {
    display: grid;
    grid-auto-rows: var(--row);
    padding: 0;
    padding-block-start: calc(var(--top) - var(--row) / 2);
    margin: 0;
    list-style: none;
  }
  .log__row {
    transition: opacity var(--dur-ui) var(--ease-out);
  }
  .log__row a {
    display: grid;
    align-content: center;
    gap: 0.15rem;
    height: 100%;
    padding-inline: 0.4rem 0.5rem;
    color: var(--ink);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .log__msg {
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-color: var(--shell-skirt);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.24em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .log__row--merge .log__msg {
    font-weight: 500;
    color: var(--ink-soft);
  }
  .log__row a:is(:hover, :focus-visible) .log__msg {
    text-decoration-color: var(--lime-ink);
  }
  .log__cmd,
  .log__refs {
    font-family: var(--ff-mono), var(--font-fa);
    font-size: 0.72rem;
    line-height: 1.35;
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
    unicode-bidi: isolate;
    justify-self: start;
  }
  :global(:root[dir='rtl']) :is(.log__cmd, .log__refs) {
    justify-self: end;
  }
  .log__row--refs {
    display: grid;
    align-content: center;
    padding-inline: 0.4rem;
  }
  .log__refs {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--lime-ink);
  }
  @media (max-width: 480px) {
    .log__msg {
      font-size: 0.86rem;
      line-height: 1.22;
    }
  }

  /* my portrait at the top: the branches grow up into it. A print in a plastic mount
     (a cap: rim on top, skirt below), its inline-start edge over main. */
  .tree__me {
    position: absolute;
    inset-block-start: calc(var(--top) - var(--me-h) - 18px);
    inset-inline-start: max(0px, calc(var(--main) - 26px));
    z-index: 1;
    display: block;
    width: var(--me-w);
    height: var(--me-h);
    padding: 7px;
    border: 1px solid var(--shell-skirt);
    border-radius: var(--radius-screen);
    background: var(--shell-lift);
    box-shadow:
      inset 0 1px 0 var(--shell-rim),
      0 var(--skirt) 0 var(--shell-skirt);
  }
  .tree__me :global(.tree__me-img) {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-sm);
    object-fit: cover;
    /* the face sits left of centre in the square original */
    object-position: 34% 50%;
  }

  /* Nix: small and still, in the corner beside the portrait, standing level with its foot */
  .stage :global(.hero__nix) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 0;
