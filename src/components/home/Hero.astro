---
/**
 * The alcove. One sentence and the email on the open wall; on the other side the
 * hanging scroll (Mahdi's photo) and the arrangement: his career drawn as a single
 * git branch rising from a bronze bowl, three lime buds for what's live now.
 * The branch leans toward the copy, so the empty wall points at the email.
 */
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { person } from '../../data/profile';
import Arrow from '../ui/Arrow.astro';
import Nix from '../art/Nix.astro';
import original from '../../assets/photo/mahdi-original.png';
import dither from '../../assets/photo/mahdi-dither.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const fa = lang === 'fa';

// buds: tip positions in the 420×560 arrangement box (x from the inline-start side)
const buds = [
  { x: 44, y: 200, label: 'InnoLearn', meta: fa ? '۱۴۰۴' : '2025', href: '#work-innolearn', above: true },
  { x: 360, y: 410, label: 'Armani English', meta: fa ? '۱۴۰۱' : '2022', href: '#work-armani' },
  { x: 164, y: 280, label: t('hero.bud.notes'), meta: '', href: lp(lang, '/blog'), above: true },
];
// commit nodes sit on the main stem (points on its curve)
const commits = [
  [214.7, 471.9],
  [222, 430],
  [160, 356],
  [102, 313.5],
];
---

<section class="alcove" id="top" aria-labelledby="hero-title">
  <div class="alcove__wall">
    <div class="copy">
      <h1 class="copy__title" id="hero-title">{t('hero.title')}</h1>
      <p class="copy__lead">{t('hero.lead')}</p>
      <div class="copy__actions">
        <a class="btn" href={`mailto:${person.email}`}>
          {t('hero.cta')}
          <Arrow />
        </a>
        <a class="arrow-link" href={lp(lang, '/blog')}>
          {t('hero.notes')}
          <Arrow />
        </a>
      </div>
      <a class="copy__resume" href={person.resume[lang]} download>{t('hero.resume')}</a>
    </div>

    <div class="arrangement">
      <figure class="scroll portrait" data-portrait>
        <span class="scroll__rod" aria-hidden="true"></span>
        <div class="scroll__frame">
          <Image class="portrait__real" src={original} widths={[240, 420]} sizes="210px" format="webp" quality={80} alt={t('whoami.photo.real.alt')} loading="eager" fetchpriority="high" />
          <div class="portrait__bits" aria-hidden="true">
            <div class="portrait__dither" data-src={`url(${dither.src})`}></div>
          </div>
          <span class="portrait__scan" aria-hidden="true"></span>
        </div>
        <figcaption class="scroll__caption">
          <span>{t('hero.photo.caption')}</span>
          <button type="button" class="scroll__toggle" data-portrait-toggle data-label-on={t('whoami.color')} data-label-off={t('whoami.dither')} aria-pressed="false">
            {t('whoami.dither')}
          </button>
        </figcaption>
      </figure>

      <svg class="branch" viewBox="0 0 420 560" role="img" aria-label={t('hero.branch.label')}>
        <g fill="none" stroke-linecap="round">
          <path class="stem stem--a" pathLength="1" d="M210 512C204 478 228 456 222 430 216 402 190 384 160 356 124 322 76 306 56 268 44 244 40 222 44 200" />
          <path class="stem stem--b" pathLength="1" d="M222 430C262 428 300 426 330 418 346 414 354 412 360 410" />
          <path class="stem stem--c" pathLength="1" d="M160 356C168 332 156 304 164 280" />
        </g>
        {commits.map(([cx, cy]) => <circle class="commit" cx={cx} cy={cy} r="5.5" />)}
        <g>
          <path class="bowl__body" d="M136 506c6 26 30 36 74 36s68-10 74-36Z" />
          <ellipse class="bowl__rim" cx="210" cy="506" rx="74" ry="8" />
          <path class="bowl__lip" d="M142 505c20 5 116 5 136 0" />
          <rect class="bowl__body" x="186" y="540" width="48" height="8" rx="2" />
        </g>
        {buds.map((b, i) => <circle class="bud" style={`--i:${i}`} cx={b.x} cy={b.y} r="10" />)}
      </svg>

      <ul class="buds" role="list">
        {
          buds.map((b, i) => (
            <li class:list={{ above: b.above, side: b.side }} style={`--x:${(b.x / 420) * 100}%;--y:${(b.y / 560) * 100}%;--i:${i}`}>
              <a href={b.href}>
                {b.label}
                {b.meta && <span class="buds__meta">{b.meta}</span>}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="shelf-nix" aria-hidden="true"><Nix size={62} bob={false} /></div>
    </div>

    <p class="coords" aria-hidden="true">{t('hero.coords')}</p>
  </div>
  <div class="shelf" aria-hidden="true"></div>
</section>

<script>
  import '../../scripts/portrait';
</script>

<style>
  .alcove {
    --branch: oklch(0.36 0.03 78);
    --bowl: oklch(0.3 0.025 78);
    --bowl-rim: oklch(0.42 0.03 78);
    --bowl-lip: oklch(0.58 0.035 78);
    position: relative;
  }
  :global(:root[data-theme='dark']) .alcove {
    --branch: oklch(0.66 0.035 78);
    --bowl: oklch(0.36 0.02 78);
    --bowl-rim: oklch(0.5 0.025 78);
    --bowl-lip: oklch(0.66 0.03 78);
  }
  .alcove__wall {
    position: relative;
    display: grid;
    gap: var(--space-l);
    padding: var(--space-l) var(--page-gutter) 0;
    max-width: calc(var(--page-max) + 2 * var(--page-gutter));
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .alcove__wall {
      grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
      align-items: end;
      gap: var(--space-xl);
      min-height: min(calc(100svh - 22px), 860px);
      padding-block-start: var(--space-xl);
    }
  }

  /* ── the open wall ── */
  .copy {
    align-self: center;
    padding-block-end: var(--space-l);
  }
  .copy__title {
    font-size: clamp(2.25rem, 1.6rem + 2.1vw, 3.4rem);
    line-height: 1.04;
    max-width: 13ch;
  }
  :global(:root[dir='rtl']) .copy__title {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.2rem);
    max-width: 16ch;
  }
  .copy__lead {
    margin-block-start: var(--space-m);
    max-width: 56ch;
    font-size: var(--step-0);
    color: var(--ink-soft);
  }
  .copy__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-block-start: var(--space-l);
  }
  .copy__resume {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    margin-block-start: 0.4rem;
    font-size: 0.88rem;
    color: var(--ink-faint);
    text-decoration-color: var(--rule);
  }
  .copy__resume:hover {
    color: var(--ink);
  }

  /* ── the arrangement ── */
  :global(:root[dir='rtl']) .coords {
    right: auto;
    left: 4px;
  }
  .arrangement {
    position: relative;
    width: min(100%, 440px);
    aspect-ratio: 420 / 560;
    justify-self: center;
  }
  /* phones: the person leads, so the scroll and branch come before the words */
  @media (max-width: 899px) {
    .arrangement {
      order: -1;
      width: min(82vw, 340px);
    }
    .shelf-nix {
      scale: 0.85;
      transform-origin: bottom;
    }
  }
  @media (min-width: 900px) {
    .arrangement {
      justify-self: end;
    }
  }
  .branch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    scale: var(--dir) 1;
  }
  .stem {
    stroke: var(--branch);
  }
  .stem--a {
    stroke-width: 7;
  }
  .stem--b {
    stroke-width: 4.5;
  }
  .stem--c {
    stroke-width: 3.5;
  }
  .commit {
    fill: var(--plaster);
    stroke: var(--branch);
    stroke-width: 2.5;
  }
  .bowl__body {
    fill: var(--bowl);
  }
  .bowl__rim {
    fill: var(--bowl-rim);
  }
  .bowl__lip {
    fill: none;
    stroke: var(--bowl-lip);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .bud {
    fill: var(--lime);
    stroke: var(--ink);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
  }

  .buds {
    position: absolute;
    inset: 0;
    list-style: none;
    padding: 0;
    pointer-events: none;
  }
  .buds li {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    translate: calc(-50% * var(--dir)) 14px;
    pointer-events: auto;
  }
  /* labels sit on the open side of their bud, never across the stem */
  .buds li.above {
    translate: calc(-50% * var(--dir)) calc(-100% - 14px);
  }
  /* beside the bud, on the side away from where its stem arrives */
  .buds li.side {
    translate: calc((-100% - 16px) * var(--dir)) -50%;
  }
  .buds a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    min-height: 32px;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    color: var(--ink);
    /* a halo in the wall colour, like a map label: the stems stay visible around the words */
    text-shadow:
      0 0 2px var(--plaster),
      0 0 2px var(--plaster),
      0 0 4px var(--plaster);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  .buds a:hover {
    background: var(--lime);
    color: var(--on-lime);
    text-shadow: none;
  }
  .buds__meta {
    font-family: var(--ff-mono);
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .buds a:hover .buds__meta {
    color: inherit;
  }

  /* ── the hanging scroll (photo) ── */
  .scroll {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 2%;
    width: 50%;
    margin: 0;
  }
  .scroll__rod {
    display: block;
    height: 7px;
    margin-inline: -8%;
    border-radius: 4px;
    background: var(--bowl);
  }
  .scroll__frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-block-start: 0;
    background: var(--plaster-deep);
  }
  .scroll__frame :global(.portrait__real) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 32% 40%;
  }
  .portrait__bits {
    position: absolute;
    inset: 0;
    background: var(--plaster-deep);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 700ms var(--ease-in-out);
  }
  .scroll:global(.is-bits) .portrait__bits {
    clip-path: inset(0 0 0 0);
  }
  .portrait__dither {
    position: absolute;
    inset: 0;
    background: var(--ink);
    mask: var(--src) center / cover no-repeat;
  }
  .portrait__scan {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 2px;
    background: var(--lime);
    opacity: 0;
    pointer-events: none;
  }
  .scroll__caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.3rem;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }
  .scroll__toggle {
    min-height: 32px;
    padding-inline: 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    font-family: var(--ff-mono);
    font-size: 0.72rem;
    color: var(--ink-soft);
    transition: border-color var(--dur-hover) var(--ease-out);
  }
  :global(:root[dir='rtl']) .scroll__toggle {
    font-family: var(--font-fa);
  }
  .scroll__toggle:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .shelf-nix {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 4%;
  }

  .coords {
    display: none;
  }
  @media (min-width: 900px) {
    /* vertical text: physical offsets, since block/inline axes rotate with it */
    .coords {
      display: block;
      position: absolute;
      top: var(--space-xl);
      right: 4px;
      writing-mode: vertical-rl;
      font-family: var(--ff-mono);
      font-size: 0.72rem;
      letter-spacing: 0.02em;
      color: var(--ink-faint);
    }
  }
  :global(:root[dir='rtl']) .coords {
    font-family: var(--font-fa);
  }

  /* the shelf the arrangement stands on */
  .shelf {
    height: 22px;
    background: var(--bowl);
    border-block-start: 3px solid var(--bowl-rim);
  }

  /* ── the one authored moment: the branch grows, then the buds open ── */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-lite])) .stem {
      stroke-dasharray: 1;
      animation: grow 1.5s var(--ease-out) both;
    }
    :global(html:not([data-lite])) .stem--a {
      animation-delay: 150ms;
    }
    :global(html:not([data-lite])) .stem--b {
      animation-delay: 700ms;
      animation-duration: 900ms;
    }
    :global(html:not([data-lite])) .stem--c {
      animation-delay: 950ms;
      animation-duration: 700ms;
    }
    :global(html:not([data-lite])) .bud {
      animation: open 520ms var(--ease-out) both;
      animation-delay: calc(1250ms + var(--i) * 140ms);
    }
    :global(html:not([data-lite])) .buds li {
      animation: label-in 400ms var(--ease-out) both;
      animation-delay: calc(1450ms + var(--i) * 140ms);
    }
  }
  @keyframes grow {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes open {
    from {
      scale: 0.2;
    }
  }
  @keyframes label-in {
    from {
      opacity: 0;
    }
  }
</style>
