---
/**
 * The alcove. Who I am and how to reach me on the open wall (phone and email are the point);
 * on the other side the hanging scroll (Mahdi's photo) and the arrangement: his career drawn
 * as a single git branch rising from a bronze bowl, three lime buds for what's live now.
 */
import { Image } from 'astro:assets';
import type { Lang } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { person } from '../../data/profile';
import Arrow from '../ui/Arrow.astro';
import Icon from '../ui/Icon.astro';
import Nix from '../art/Nix.astro';
import original from '../../assets/photo/mahdi-original.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const fa = lang === 'fa';

// buds: tip positions in the 420×560 arrangement box (x from the inline-start side)
const buds = [
  { x: 44, y: 200, label: 'InnoLearn', meta: fa ? '۱۴۰۴' : '2025', href: '#work-innolearn', above: true },
  { x: 360, y: 410, label: 'Armani English', meta: fa ? '۱۴۰۱' : '2022', href: '#work-armani' },
  { x: 128, y: 292, label: t('hero.bud.notes'), meta: '', href: lp(lang, '/blog'), above: true },
];
// commit nodes sit on the main stem (points on its curve)
const commits = [
  [214.7, 471.9],
  [222, 430],
  [160, 356],
  [102, 313.5],
];
---

<section class="alcove" id="top" aria-labelledby="hero-title">
  <div class="alcove__wall">
    <div class="copy">
      <h1 class="copy__title" id="hero-title">{t('hero.title')}</h1>
      <p class="copy__lead">{t('hero.lead')}</p>
      <div class="copy__actions">
        <a class="btn" href="#work">
          {t('hero.work')}
          <Arrow />
        </a>
        <a class="btn btn--ghost" href={lp(lang, '/blog')}>
          {t('hero.blog')}
        </a>
      </div>
      <ul class="reach" role="list" aria-label={t('hero.reach')}>
        <li>
          <a href={`tel:${person.phone.tel}`}>
            <Icon name="phone" size={20} />
            <span class="reach__label">{t('contact.phone.label')}</span>
            <span class="reach__val" dir="ltr">{person.phone.display[lang]}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${person.email}`}>
            <Icon name="mail" size={20} />
            <span class="reach__label">{t('contact.email.label')}</span>
            <span class="reach__val" dir="ltr">{person.email}</span>
          </a>
        </li>
      </ul>
      <a class="resume-btn" href={person.resume[lang]} download data-resume>
        <Icon name="download" size={22} />
        <span>{t('hero.resume')}</span>
        <span class="resume-btn__meta">EN · FA</span>
      </a>
    </div>

    <div class="arrangement">
      <figure class="scroll">
        <span class="scroll__rod" aria-hidden="true"></span>
        <div class="scroll__frame">
          <Image class="portrait__real" src={original} widths={[300, 580]} sizes="(min-width: 900px) 290px, 48vw" format="webp" quality={80} alt={t('whoami.photo.real.alt')} loading="eager" fetchpriority="high" />
        </div>
      </figure>

      <svg class="branch" viewBox="0 0 420 560" role="img" aria-label={t('hero.branch.label')}>
        <g fill="none" stroke-linecap="round">
          <path class="stem stem--a" pathLength="1" d="M210 526L210 512C204 478 228 456 222 430 216 402 190 384 160 356 124 322 76 306 56 268 44 244 40 222 44 200" />
          <path class="stem stem--b" pathLength="1" d="M222 430C262 428 300 426 330 418 346 414 354 412 360 410" />
          <path class="stem stem--c" pathLength="1" d="M160 356C150 336 132 320 128 292" />
        </g>
        {commits.map(([cx, cy]) => <circle class="commit" cx={cx} cy={cy} r="5.5" />)}
        <g transform="translate(0 12)">
          <path class="bowl__body" d="M136 506c6 26 30 36 74 36s68-10 74-36Z" />
          <ellipse class="bowl__rim" cx="210" cy="506" rx="74" ry="8" />
          <path class="bowl__lip" d="M142 505c20 5 116 5 136 0" />
          <rect class="bowl__body" x="186" y="540" width="48" height="8" rx="2" />
        </g>
        {buds.map((b, i) => <circle class="bud" style={`--i:${i}`} cx={b.x} cy={b.y} r="10" />)}
      </svg>

      <ul class="buds" role="list">
        {
          buds.map((b, i) => (
            <li class:list={{ above: b.above }} style={`--x:${(b.x / 420) * 100}%;--y:${(b.y / 560) * 100}%;--i:${i}`}>
              <a href={b.href}>
                {b.label}
                {b.meta && <span class="buds__meta">{b.meta}</span>}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="shelf-nix"><Nix size={92} eager /></div>
    </div>
  </div>
  <div class="shelf" aria-hidden="true"></div>
</section>


<style>
  .alcove {
    --branch: oklch(0.36 0.03 78);
    --bowl: oklch(0.3 0.025 78);
    --bowl-rim: oklch(0.42 0.03 78);
    --bowl-lip: oklch(0.58 0.035 78);
    position: relative;
  }
  :global(:root[data-theme='dark']) .alcove {
    --branch: oklch(0.66 0.035 78);
    --bowl: oklch(0.36 0.02 78);
    --bowl-rim: oklch(0.5 0.025 78);
    --bowl-lip: oklch(0.66 0.03 78);
  }
  .alcove__wall {
    position: relative;
    display: grid;
    gap: var(--space-l);
    padding: var(--space-l) var(--page-gutter) 0;
    max-width: calc(var(--page-max) + 2 * var(--page-gutter));
    margin-inline: auto;
  }
  @media (min-width: 900px) {
    .alcove__wall {
      grid-template-columns: minmax(0, 1.15fr) minmax(300px, 0.85fr);
      align-items: end;
      gap: var(--space-xl);
      min-height: min(calc(100svh - 82px), 860px);
      padding-block-start: var(--space-xl);
    }
  }

  /* ── the open wall ── */
  .copy {
    align-self: center;
    padding-block-end: var(--space-l);
  }
  .copy__title {
    font-size: clamp(2.25rem, 1.6rem + 2.1vw, 3.4rem);
    line-height: 1.04;
    max-width: 15ch;
  }
  :global(:root[dir='rtl']) .copy__title {
    font-size: clamp(2rem, 1.4rem + 2.2vw, 3.2rem);
    max-width: 17ch;
  }
  .copy__lead {
    margin-block-start: var(--space-m);
    max-width: 60ch;
    font-size: var(--step-0);
    color: var(--ink-soft);
  }
  .copy__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-block-start: var(--space-l);
  }

  /* phone + email: set as plainly as a business card, never hidden behind a click */
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-l);
    margin-block-start: var(--space-m);
    padding: 0;
    list-style: none;
  }
  .reach a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 48px;
    color: var(--ink);
    text-decoration: none;
  }
  .reach a :global(.icon) {
    color: var(--ink-soft);
  }
  .reach__label {
    font-size: 0.82rem;
    color: var(--ink-faint);
  }
  .reach__val {
    font-weight: 600;
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
    unicode-bidi: isolate;
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .reach a:hover .reach__val {
    text-decoration-color: var(--lime-ink);
  }
  @media (max-width: 480px) {
    .reach__val {
      font-size: 0.98rem;
      overflow-wrap: anywhere;
    }
  }

  /* the resume: a big, obvious ticket that opens the EN/FA picker */
  .resume-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 60px;
    margin-block-start: var(--space-s);
    padding: 0.7rem 1.4rem;
    border: var(--bw) dashed var(--rule-strong);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-size: 1.08rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--dur-hover) var(--ease-out),
      border-style var(--dur-hover) var(--ease-out),
      scale var(--dur-press) var(--ease-out);
  }
  .resume-btn__meta {
    font-family: var(--ff-mono);
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--ink-faint);
  }
  .resume-btn :global(.icon) {
    transition: translate var(--dur-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .resume-btn:hover {
      border-style: solid;
      background: var(--plaster-deep);
    }
    .resume-btn:hover :global(.icon) {
      translate: 0 2px;
    }
  }
  .resume-btn:active {
    scale: 0.98;
  }

  /* ── the arrangement ── */
  .arrangement {
    position: relative;
    width: min(100%, 500px);
    aspect-ratio: 420 / 560;
    justify-self: center;
  }
  /* phones: the person leads, so the scroll and branch come before the words */
  @media (max-width: 899px) {
    .arrangement {
      order: -1;
      width: min(88vw, 380px);
    }
    .shelf-nix :global(.nix) {
      width: 74px;
    }
  }
  @media (min-width: 900px) {
    .arrangement {
      justify-self: end;
    }
  }
  .branch {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    scale: var(--dir) 1;
  }
  .stem {
    stroke: var(--branch);
  }
  .stem--a {
    stroke-width: 7;
  }
  .stem--b {
    stroke-width: 4.5;
  }
  .stem--c {
    stroke-width: 3.5;
  }
  .commit {
    fill: var(--plaster);
    stroke: var(--branch);
    stroke-width: 2.5;
  }
  .bowl__body {
    fill: var(--bowl);
  }
  .bowl__rim {
    fill: var(--bowl-rim);
  }
  .bowl__lip {
    fill: none;
    stroke: var(--bowl-lip);
    stroke-width: 1.5;
    stroke-linecap: round;
  }
  .bud {
    fill: var(--lime);
    stroke: var(--ink);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
  }

  .buds {
    position: absolute;
    inset: 0;
    list-style: none;
    padding: 0;
    pointer-events: none;
  }
  .buds li {
    position: absolute;
    inset-inline-start: var(--x);
    inset-block-start: var(--y);
    translate: calc(-50% * var(--dir)) 14px;
    pointer-events: auto;
  }
  /* labels sit on the open side of their bud, never across the stem */
  .buds li.above {
    translate: calc(-50% * var(--dir)) calc(-100% - 14px);
  }
  .buds a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    min-height: 32px;
    padding: 0.2rem 0.5rem;
    border-radius: 3px;
    color: var(--ink);
    /* a halo in the wall colour, like a map label: the stems stay visible around the words */
    text-shadow:
      0 0 2px var(--plaster),
      0 0 2px var(--plaster),
      0 0 4px var(--plaster);
    font-size: 0.82rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color var(--dur-hover) var(--ease-out);
  }
  .buds a:hover {
    background: var(--lime);
    color: var(--on-lime);
    text-shadow: none;
  }
  .buds__meta {
    font-family: var(--ff-mono);
    font-weight: 400;
    font-size: 0.72rem;
    color: var(--ink-faint);
  }
  .buds a:hover .buds__meta {
    color: inherit;
  }

  /* ── the hanging scroll (photo) ── */
  .scroll {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: 2%;
    width: 58%;
    margin: 0;
  }
  .scroll__rod {
    display: block;
    height: 7px;
    margin-inline: -8%;
    border-radius: 4px;
    background: var(--bowl);
  }
  .scroll__frame {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border: 1px solid var(--rule-strong);
    border-block-start: 0;
    background: var(--plaster-deep);
  }
  .scroll__frame :global(.portrait__real) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 32% 40%;
  }
  .shelf-nix {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: 0;
    /* he waves toward the words */
    scale: calc(-1 * var(--dir)) 1;
  }
  .shelf-nix :global(.nix) {
    transform-origin: 50% 100%;
    transition: rotate 420ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .shelf-nix:hover :global(.nix) {
      rotate: -6deg;
    }
  }

  /* the shelf the arrangement stands on */
  .shelf {
    height: 22px;
    background: var(--bowl);
    border-block-start: 3px solid var(--bowl-rim);
  }

  /* ── the one authored moment: the branch grows, then the buds open ── */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not([data-lite])) .stem {
      stroke-dasharray: 1;
      animation: grow 1.5s var(--ease-out) both;
    }
    :global(html:not([data-lite])) .stem--a {
      animation-delay: 150ms;
    }
    :global(html:not([data-lite])) .stem--b {
      animation-delay: 700ms;
      animation-duration: 900ms;
    }
    :global(html:not([data-lite])) .stem--c {
      animation-delay: 950ms;
      animation-duration: 700ms;
    }
    :global(html:not([data-lite])) .bud {
      animation: open 520ms var(--ease-out) both;
      animation-delay: calc(1250ms + var(--i) * 140ms);
    }
    :global(html:not([data-lite])) .buds li {
      animation: label-in 400ms var(--ease-out) both;
      animation-delay: calc(1450ms + var(--i) * 140ms);
    }
  }
  @keyframes grow {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes open {
    from {
      scale: 0.2;
    }
  }
  @keyframes label-in {
    from {
      opacity: 0;
    }
  }
</style>
