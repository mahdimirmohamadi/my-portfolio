---
/** Skills: grouped tool lists with their marks. Compact, scannable, no fake percentages. */
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { stack } from '../../data/profile';
import SectionHead from '../ui/SectionHead.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="section wrap" id="skills" aria-labelledby="skills-title">
  <SectionHead title={t('skills.title')} lead={t('skills.lead')} id="skills-title" />
  <dl class="skills">
    {
      stack.map((g) => (
        <div class="group">
          <dt>{g.label[lang]}</dt>
          <dd>
            <ul role="list">
              {g.items.map((name) => (
                <li class="tool">
                  <Logo name={name} size={16} />
                  {name}
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .skills {
    display: grid;
    border-block-start: 1px solid var(--rule);
  }
  @media (min-width: 960px) {
    .skills {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-xl);
    }
    .group:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .group {
    display: grid;
    gap: 0.5rem;
    padding-block: 0.9rem;
    border-block-end: 1px solid var(--rule);
  }
  @media (min-width: 560px) {
    .group {
      grid-template-columns: 7.5rem 1fr;
      align-items: baseline;
      gap: var(--space-s);
    }
  }
  dt {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ink-faint);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.1rem;
    list-style: none;
    padding: 0;
  }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.95rem;
    color: var(--ink);
    white-space: nowrap;
    direction: ltr;
  }
  .tool :global(.logo) {
    color: var(--ink-soft);
  }
</style>
