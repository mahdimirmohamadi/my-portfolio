---
/**
 * Skills: grouped tool lists with their marks. Compact, scannable, no fake percentages.
 * Tool names are English, so the list reads left to right in both languages. Hovering a tool
 * lights it in its own brand colour.
 */
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { stack } from '../../data/profile';
import { logoOf } from '../../data/logos';
import SectionHead from '../ui/SectionHead.astro';
import Logo from '../ui/Logo.astro';
import Nix from '../art/Nix.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="section wrap" id="skills" aria-labelledby="skills-title">
  <div class="skills__head">
    <SectionHead title={t('skills.title')} lead={t('skills.lead')} id="skills-title" />
    <Nix mood="hardhat" size={104} class="skills__nix" />
  </div>
  <dl class="skills" dir="ltr">
    {
      stack.map((g) => (
        <div class="group">
          <dt dir="auto" lang={lang === 'fa' ? 'fa' : undefined}>
            {g.label[lang]}
          </dt>
          <dd>
            <ul role="list">
              {g.items.map((name) => {
                const logo = logoOf(name);
                return (
                  <li class:list={['tool', { 'tool--dark': logo?.dark }]} style={logo ? `--brand-hex:${logo.hex}` : undefined}>
                    <Logo name={name} size={16} />
                    {name}
                  </li>
                );
              })}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .skills__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
  }
  /* Nix in his hard hat: these are the tools */
  .skills__head :global(.skills__nix) {
    width: clamp(70px, 9vw, 104px);
    margin-block-end: var(--space-m);
    transform: scaleX(calc(-1 * var(--dir)));
  }
  .skills {
    display: grid;
    border-block-start: 1px solid var(--shell-skirt);
    text-align: left;
  }
  @media (min-width: 960px) {
    .skills {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-xl);
    }
    .group:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }
  .group {
    display: grid;
    gap: 0.5rem;
    padding-block: 0.9rem;
    border-block-end: 1px solid var(--rule);
  }
  @media (min-width: 560px) {
    .group {
      grid-template-columns: 8rem 1fr;
      align-items: baseline;
      gap: var(--space-s);
    }
  }
  dt {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-faint);
    text-align: left;
  }
  dt[lang='fa'] {
    font-family: var(--font-fa);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
  }
  /* the brand colour arrives as --brand-hex (inline); --brand is derived here so night can override it */
  .tool {
    --brand: var(--brand-hex, var(--ink));
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 36px;
    padding-inline: 0.65rem 0.8rem;
    border: 1px solid var(--shell-skirt);
    border-radius: 7px;
    background: var(--shell-lift);
    box-shadow:
      inset 0 1px 0 var(--shell-rim),
      0 2px 0 var(--shell-skirt);
    font-family: var(--font-body);
    font-size: 0.92rem;
    color: var(--ink);
    white-space: nowrap;
    transition:
      border-color var(--dur-hover) var(--ease-out),
      background-color var(--dur-hover) var(--ease-out),
      color var(--dur-hover) var(--ease-out);
  }
  .tool :global(.logo) {
    color: var(--ink-soft);
    transition: color var(--dur-hover) var(--ease-out);
  }
  /* near-black brands (Next.js, GitHub, Cursor…) would vanish at night: they light in ink */
  :global(:root[data-theme='dark']) .tool--dark {
    --brand: var(--ink);
  }
  @media (hover: hover) and (pointer: fine) {
    .tool:hover {
      border-color: var(--brand);
      background: color-mix(in oklch, var(--brand) 12%, var(--shell-lift));
    }
    .tool:hover :global(.logo) {
      color: var(--brand);
    }
  }
</style>
