---
/**
 * The close: the whole width goes to glass. The phone number and the email lit in phosphor at
 * display size, equal weight, the call first; then everywhere else, quieter, on the same screen.
 */
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { person } from '../../data/profile';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import Nix from '../art/Nix.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const logoOf: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', telegram: 'Telegram', x: 'X' };
---

<section class="close on-glass" id="contact" aria-labelledby="contact-title">
  <div class="close__inner wrap">
    <div class="close__head">
      <h2 class="close__title" id="contact-title">{t('contact.title')}</h2>
      <Nix size={104} class="close__nix" />
    </div>
    <p class="close__lead">{t('contact.lead')}</p>

    <dl class="lines">
      <div>
        <dt>{t('contact.phone.label')}</dt>
        <dd><a href={`tel:${person.phone.tel}`} dir="ltr">{person.phone.display[lang]}</a></dd>
        <Nix mood="call" size={72} class="lines__nix" />
      </div>
      <div>
        <dt>{t('contact.email.label')}</dt>
        <dd><a href={`mailto:${person.email}`} dir="ltr">{person.email}</a></dd>
        <Nix mood="mail" size={72} class="lines__nix" />
      </div>
    </dl>

    <div class="close__actions">
      <a class="btn btn--lit" href={`tel:${person.phone.tel}`}>
        <Icon name="phone" size={20} />
        {t('contact.call')}
      </a>
      <a class="btn btn--glass" href={`mailto:${person.email}`}>
        <Icon name="mail" size={20} />
        {t('contact.email')}
      </a>
    </div>

    <div class="elsewhere">
      <h3 class="elsewhere__title">{t('contact.elsewhere')}</h3>
      <ul role="list">
        {
          person.links.map((l) => (
            <li>
              <a href={l.href} target="_blank" rel="me noopener">
                <Logo name={logoOf[l.id] ?? l.label} size={18} />
                <span>{l.label}</span>
                <span class="elsewhere__handle">{l.handle.replace(/^[^/]+\//, '')}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={person.resume[lang]} download data-resume>
            <Icon name="download" size={18} />
            <span>{t('hero.resume')}</span>
            <span class="elsewhere__handle">EN · FA</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  /* the screen: full bleed, bezel lines top and bottom */
  .close {
    margin-block-start: var(--space-2xl);
    padding-block: var(--space-2xl);
    background: var(--glass);
    color: var(--on-glass);
    border-block: 1px solid var(--shell-skirt);
    box-shadow:
      inset 0 1px 0 var(--glass-line),
      inset 0 -1px 0 var(--glass-line);
    scroll-margin-block-start: 1rem;
  }
  .close ::selection {
    background: var(--phosphor);
    color: var(--on-lime);
  }
  .close__head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-s);
  }
  .close__title {
    font-size: var(--step-5);
    color: var(--on-glass);
  }
  .close__head :global(.close__nix) {
    width: clamp(68px, 12vw, 104px);
    margin-block-end: 0.2em;
  }
  .close__lead {
    margin-block-start: var(--space-s);
    color: var(--on-glass-soft);
    font-size: var(--step-1);
    max-width: 60ch;
  }

  /* phone and email, lit: the two things this page exists for */
  .lines {
    display: grid;
    margin-block-start: var(--space-l);
    border-block-start: 1px solid var(--glass-bezel);
  }
  .lines > div {
    position: relative;
    display: grid;
    gap: 0.1rem var(--space-m);
    align-content: center;
    min-height: 96px;
    padding-block: var(--space-s);
    padding-inline-end: 72px;
    border-block-end: 1px solid var(--glass-bezel);
  }
  @media (min-width: 700px) {
    .lines > div {
      grid-template-columns: 7rem 1fr;
      align-items: baseline;
      padding-inline-end: 96px;
    }
  }
  /* each line has its Nix: on the phone, holding the envelope */
  .lines :global(.lines__nix) {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0;
    translate: 0 -50%;
    width: clamp(52px, 7vw, 68px);
    transform: scaleX(var(--dir));
  }
  /* small phones: the address needs the whole row */
  @media (max-width: 479px) {
    .lines > div {
      padding-inline-end: 0;
    }
    .lines :global(.lines__nix) {
      display: none;
    }
  }
  .lines dt {
    font-family: var(--ff-mono);
    font-size: 0.8rem;
    color: var(--on-glass-faint);
  }
  :global(:root[dir='rtl']) .lines dt {
    font-family: var(--font-fa);
    font-size: 0.9rem;
  }
  .lines dd {
    font-family: var(--ff-mono);
    font-weight: 600;
    font-size: clamp(1.25rem, 0.6rem + 2.6vw, 2.6rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }
  .lines dd a {
    display: inline-block;
    color: var(--phosphor);
    text-shadow: 0 0 14px oklch(0.905 0.2 124 / 0.32);
    text-decoration: underline;
    text-decoration-color: var(--glass-bezel);
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.2em;
    unicode-bidi: isolate;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .lines dd a:hover {
    text-decoration-color: var(--phosphor);
  }
  :global(:root[dir='rtl']) .lines dd a[href^='tel'] {
    font-family: var(--font-fa);
    letter-spacing: 0;
  }

  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }
  .close__actions .btn {
    min-height: 54px;
    font-size: 1.05rem;
  }
  :global(:root[dir='rtl']) .close__actions .btn :global(svg.icon) {
    scale: 1 1;
  }

  .elsewhere {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-2xl);
  }
  @media (min-width: 760px) {
    .elsewhere {
      grid-template-columns: 9rem 1fr;
      align-items: baseline;
    }
  }
  .elsewhere__title {
    font-size: var(--step-1);
    color: var(--on-glass);
  }
  .elsewhere ul {
    display: grid;
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--glass-line);
  }
  @media (min-width: 760px) {
    .elsewhere ul {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-l);
    }
  }
  .elsewhere a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 52px;
    border-block-end: 1px solid var(--glass-line);
    color: var(--on-glass);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .elsewhere a :global(:is(.logo, .icon)) {
    color: var(--on-glass-soft);
  }
  .elsewhere__handle {
    margin-inline-start: auto;
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--on-glass-faint);
    direction: ltr;
  }
  .elsewhere a:hover .elsewhere__handle,
  .elsewhere a:hover :global(:is(.logo, .icon)) {
    color: var(--phosphor);
  }
</style>
