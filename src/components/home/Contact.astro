---
/** The close: phone and email set large and equal, the call first; then everywhere else. */
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { person } from '../../data/profile';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import Nix from '../art/Nix.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const logoOf: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', telegram: 'Telegram', x: 'X' };
---

<section class="section wrap close" id="contact" aria-labelledby="contact-title">
  <span class="shelf-rule close__shelf" aria-hidden="true"></span>
  <div class="close__head">
    <h2 class="close__title" id="contact-title">{t('contact.title')}</h2>
    <Nix size={104} class="close__nix" />
  </div>
  <p class="close__lead">{t('contact.lead')}</p>

  <dl class="lines">
    <div>
      <dt>{t('contact.phone.label')}</dt>
      <dd><a href={`tel:${person.phone.tel}`} dir="ltr">{person.phone.display[lang]}</a></dd>
      <Nix mood="call" size={72} class="lines__nix" />
    </div>
    <div>
      <dt>{t('contact.email.label')}</dt>
      <dd><a href={`mailto:${person.email}`} dir="ltr">{person.email}</a></dd>
      <Nix mood="mail" size={72} class="lines__nix" />
    </div>
  </dl>

  <div class="close__actions">
    <a class="btn" href={`tel:${person.phone.tel}`}>
      <Icon name="phone" size={20} />
      {t('contact.call')}
    </a>
    <a class="btn btn--ghost" href={`mailto:${person.email}`}>
      <Icon name="mail" size={20} />
      {t('contact.email')}
    </a>
  </div>

  <div class="elsewhere">
    <h3 class="elsewhere__title">{t('contact.elsewhere')}</h3>
    <ul role="list">
      {
        person.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="me noopener">
              <Logo name={logoOf[l.id] ?? l.label} size={18} />
              <span>{l.label}</span>
              <span class="elsewhere__handle">{l.handle.replace(/^[^/]+\//, '')}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href={person.resume[lang]} download data-resume>
          <Icon name="download" size={18} />
          <span>{t('hero.resume')}</span>
          <span class="elsewhere__handle">EN · FA</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  #contact {
    --anchor-extra: -103px;
  }
  .close__shelf {
    margin-block-end: var(--space-xl);
  }
  .close__head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-s);
  }
  .close__title {
    font-size: var(--step-5);
  }
  .close__head :global(.close__nix) {
    width: clamp(68px, 12vw, 104px);
    margin-block-end: 0.2em;
  }
  .close__lead {
    margin-block-start: var(--space-s);
    color: var(--ink-soft);
    font-size: var(--step-1);
  }

  /* phone and email, equal weight: the two things this page exists for */
  .lines {
    display: grid;
    margin-block-start: var(--space-l);
    border-block-start: 1px solid var(--rule-strong);
  }
  .lines > div {
    position: relative;
    display: grid;
    gap: 0.1rem var(--space-m);
    align-content: center;
    min-height: 88px;
    padding-block: var(--space-s);
    padding-inline-end: 72px;
    border-block-end: 1px solid var(--rule-strong);
  }
  @media (min-width: 700px) {
    .lines > div {
      grid-template-columns: 7rem 1fr;
      align-items: baseline;
      padding-inline-end: 96px;
    }
  }
  /* each line has its Nix: on the phone, holding the envelope */
  .lines :global(.lines__nix) {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0;
    translate: 0 -50%;
    width: clamp(52px, 7vw, 68px);
    transform: scaleX(var(--dir));
  }
  /* small phones: the address needs the whole row */
  @media (max-width: 479px) {
    .lines > div {
      padding-inline-end: 0;
    }
    .lines :global(.lines__nix) {
      display: none;
    }
  }
  .lines dt {
    font-size: 0.9rem;
    color: var(--ink-faint);
  }
  .lines dd {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(1.2rem, 0.75rem + 2.3vw, 2.3rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    overflow-wrap: anywhere;
    font-variant-numeric: tabular-nums;
  }
  .lines dd a {
    display: inline-block;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.18em;
    unicode-bidi: isolate;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .lines dd a:hover {
    text-decoration-color: var(--lime-ink);
  }
  :global(:root[dir='rtl']) .lines dd a[href^='tel'] {
    font-family: var(--font-fa);
    letter-spacing: 0;
  }

  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }
  .close__actions .btn {
    min-height: 54px;
    font-size: 1.05rem;
  }
  :global(:root[dir='rtl']) .close__actions .btn :global(svg.icon) {
    scale: 1 1;
  }

  .elsewhere {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-2xl);
  }
  @media (min-width: 760px) {
    .elsewhere {
      grid-template-columns: 9rem 1fr;
      align-items: baseline;
    }
  }
  .elsewhere__title {
    font-size: var(--step-1);
  }
  .elsewhere ul {
    display: grid;
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--rule);
  }
  @media (min-width: 760px) {
    .elsewhere ul {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-l);
    }
  }
  .elsewhere a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 52px;
    border-block-end: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .elsewhere a :global(:is(.logo, .icon)) {
    color: var(--ink-soft);
  }
  .elsewhere__handle {
    margin-inline-start: auto;
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--ink-faint);
    direction: ltr;
  }
  .elsewhere a:hover .elsewhere__handle {
    color: var(--lime-ink);
  }
</style>
