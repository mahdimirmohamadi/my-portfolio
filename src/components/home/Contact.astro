---
/** The close: a plain invitation, the address set large, then everywhere else. */
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { person } from '../../data/profile';
import Logo from '../ui/Logo.astro';
import Arrow from '../ui/Arrow.astro';
import Nix from '../art/Nix.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const logoOf: Record<string, string> = { github: 'GitHub', linkedin: 'LinkedIn', telegram: 'Telegram' };
---

<section class="section wrap close" id="contact" aria-labelledby="contact-title">
  <span class="shelf-rule close__shelf" aria-hidden="true"></span>
  <div class="close__head">
    <h2 class="close__title" id="contact-title">{t('contact.title')}</h2>
    <Nix size={96} class="close__nix" />
  </div>
  <p class="close__lead">{t('contact.lead')}</p>
  <p class="close__mail">
    <a href={`mailto:${person.email}`}>{person.email}</a>
  </p>
  <div class="close__actions">
    <a class="btn" href={`mailto:${person.email}`}>
      {t('hero.cta')}
      <Arrow />
    </a>
    <button type="button" class="btn btn--ghost" data-copy={person.email} data-copied={t('contact.copied')}>
      <span data-copy-label>{t('contact.copy')}</span>
    </button>
  </div>

  <div class="elsewhere">
    <h3 class="elsewhere__title">{t('contact.elsewhere')}</h3>
    <ul role="list">
      {
        person.links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="me noopener">
              <Logo name={logoOf[l.id] ?? l.label} size={18} />
              <span>{l.label}</span>
              <span class="elsewhere__handle">{l.handle.replace(/^[^/]+\//, '')}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href={person.resume.en} download>
          <span>{t('contact.resume.en')}</span>
          <span class="elsewhere__handle">PDF</span>
        </a>
      </li>
      <li>
        <a href={person.resume.fa} download>
          <span>{t('contact.resume.fa')}</span>
          <span class="elsewhere__handle">PDF</span>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .close__shelf {
    margin-block-end: var(--space-xl);
  }
  .close__head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-s);
  }
  .close__title {
    font-size: var(--step-5);
  }
  .close__head :global(.close__nix) {
    width: clamp(64px, 12vw, 96px);
    margin-block-end: 0.2em;
  }
  .close__lead {
    margin-block-start: var(--space-s);
    max-width: 52ch;
    color: var(--ink-soft);
    font-size: var(--step-1);
  }
  .close__mail {
    margin-block-start: var(--space-l);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: clamp(1.2rem, 0.75rem + 2.3vw, 2.3rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
    overflow-wrap: anywhere;
    direction: ltr;
    text-align: start;
    unicode-bidi: plaintext;
  }
  .close__mail a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--lime);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.18em;
    transition: text-decoration-color var(--dur-hover) var(--ease-out);
  }
  .close__mail a:hover {
    text-decoration-color: var(--lime-ink);
  }
  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-block-start: var(--space-l);
  }

  .elsewhere {
    display: grid;
    gap: var(--space-s);
    margin-block-start: var(--space-2xl);
  }
  @media (min-width: 760px) {
    .elsewhere {
      grid-template-columns: 9rem 1fr;
      align-items: baseline;
    }
  }
  .elsewhere__title {
    font-size: var(--step-1);
  }
  .elsewhere ul {
    display: grid;
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--rule);
  }
  @media (min-width: 760px) {
    .elsewhere ul {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--space-l);
    }
  }
  .elsewhere a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 52px;
    border-block-end: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    transition: color var(--dur-hover) var(--ease-out);
  }
  .elsewhere a :global(.logo) {
    color: var(--ink-soft);
  }
  .elsewhere__handle {
    margin-inline-start: auto;
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--ink-faint);
    direction: ltr;
  }
  .elsewhere a:hover .elsewhere__handle {
    color: var(--lime-ink);
  }
</style>
