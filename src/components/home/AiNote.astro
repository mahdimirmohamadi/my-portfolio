---
/** How I use AI: one honest paragraph and the tools by their marks; the AI I shipped lives in Work. */
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { aiTools } from '../../data/profile';
import SectionHead from '../ui/SectionHead.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
---

<section class="section wrap" id="ai" aria-labelledby="ai-title">
  <div class="ai">
    <SectionHead title={t('ai.title')} lead={t('ai.lead')} id="ai-title" />
    <ul class="tools" role="list" aria-label={t('ai.tools')}>
      {
        aiTools.map((tool) => (
          <li>
            <Logo name={tool} size={22} />
            {tool}
          </li>
        ))
      }
    </ul>
    <p class="ai__note">
      <a href="#work-armani">{t('ai.shipped.note')}</a>
    </p>
  </div>
</section>

<style>
  .tools {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    list-style: none;
    padding: 0;
    border-block-start: 1px solid var(--rule);
  }
  @media (min-width: 760px) {
    .tools {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .tools li {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 60px;
    border-block-end: 1px solid var(--rule);
    font-weight: 600;
  }
  .ai__note {
    margin-block-start: var(--space-s);
    font-size: 0.95rem;
  }
  .ai__note a {
    color: var(--ink-soft);
    text-decoration-color: var(--rule);
    text-underline-offset: 0.25em;
  }
  .ai__note a:hover {
    color: var(--ink);
    text-decoration-color: var(--lime-ink);
  }
</style>
