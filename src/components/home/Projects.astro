---
/** Projects: the ones with a live site as framed prints, the rest as an index. */
import type { Lang } from '../../i18n/ui';
import { useT, lp } from '../../i18n/utils';
import { getProjects, slugOf } from '../../lib/content';
import { shotOf } from '../../lib/shots';
import SectionHead from '../ui/SectionHead.astro';
import ProjectCard from './ProjectCard.astro';
import Arrow from '../ui/Arrow.astro';

interface Props {
  lang: Lang;
  standalone?: boolean;
}
const { lang, standalone = false } = Astro.props;
const t = useT(lang);
const items = await getProjects(lang);
const prints = items.filter((p) => shotOf(slugOf(p)));
const lines = items.filter((p) => !shotOf(slugOf(p)));
---

<section class="section wrap" id="projects" aria-labelledby="projects-title">
  <SectionHead title={t('projects.title')} lead={t('projects.lead')} id="projects-title" />
  <div class="prints">
    {
      prints.map((item) => (
        <div class="slot">
          <ProjectCard lang={lang} item={item} />
        </div>
      ))
    }
  </div>
  <div class="lines">
    {lines.map((item) => <ProjectCard lang={lang} item={item} />)}
  </div>
  {
    !standalone && (
      <p class="more">
        <a class="arrow-link" href={lp(lang, '/projects')}>
          {t('projects.all')}
          <Arrow />
        </a>
      </p>
    )
  }
</section>

<style>
  .prints {
    display: grid;
    gap: var(--space-xl) var(--space-l);
  }
  .slot {
    container: prints / inline-size;
  }
  @media (min-width: 900px) {
    .prints {
      grid-template-columns: 1fr 1fr;
    }
    .slot:first-child {
      grid-column: 1 / -1;
    }
  }
  .lines {
    margin-block-start: var(--space-xl);
    border-block-end: 1px solid var(--rule);
  }
  .more {
    margin-block-start: var(--space-m);
  }
</style>
