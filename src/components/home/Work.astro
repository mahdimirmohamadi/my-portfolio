---
/**
 * Experience: the hero's branch carried down the page. One bronze stem, a lime bud for each
 * team I'm still with, hollow commit nodes for school. Nix is at his desk by the title;
 * the graduate Nix sits by school. What I built at each place sits in its
 * own recess beside the story, so the eye can skim either column.
 */
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { jobs, education } from '../../data/profile';
import SectionHead from '../ui/SectionHead.astro';
import Arrow from '../ui/Arrow.astro';
import Nix from '../art/Nix.astro';
import Logo from '../ui/Logo.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const fa = lang === 'fa';
const when = (j: (typeof jobs)[number]) =>
  fa ? `${t('work.since')} ${j.since.month.fa} ${j.since.year.fa} ${t('work.now')}` : `${j.since.month.en} ${j.since.year.en} – ${t('work.now')}`;
---

<section class="section wrap" id="work" aria-labelledby="work-title">
  <div class="work__head">
    <SectionHead title={t('work.title')} id="work-title" />
    <Nix mood="desk" size={130} class="work__nix" />
  </div>
  <ol class="stem" role="list">
    {
      jobs.map((j) => (
        <li class="job" id={`work-${j.id}`}>
          <span class="node node--bud" aria-hidden="true" />
          <div class="job__story">
            <h3 class="job__company">
              {j.url ? (
                <a href={j.url} target="_blank" rel="noopener">
                  {j.company}
                  <Arrow kind="out" size={16} />
                </a>
              ) : (
                j.company
              )}
            </h3>
            <p class="job__meta">
              <time class="job__when" datetime={j.since.iso}>
                {when(j)}
              </time>
              <span>
                {j.place[lang]} · {j.mode[lang]}
              </span>
            </p>
            <p class="job__role">{j.role[lang]}</p>
            <p class="job__about">{j.about[lang]}</p>
            <p class="job__products">
              {j.products.map((p) => (
                <a href={p.href} target="_blank" rel="noopener" dir="ltr">
                  {p.label}
                  <Arrow kind="out" size={13} />
                </a>
              ))}
            </p>
            <ul class="job__stack" role="list" aria-label={t('work.stack')} dir="ltr">
              {j.stack.map((name) => (
                <li>
                  <Logo name={name} size={14} />
                  {name}
                </li>
              ))}
            </ul>
          </div>
          <div class="built">
            <h4 class="built__title">{t('work.shipped')}</h4>
            <ul role="list">
              {j.shipped[lang].map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
    <li class="school">
      <span class="node" aria-hidden="true"></span>
      <div class="school__head">
        <h3 class="school__title">{t('work.edu')}</h3>
        <Nix mood="grad" size={72} class="school__nix" />
      </div>
      <ul class="school__list" role="list">
        {
          education.map((e) => (
            <li>
              <b>{e.title[lang]}</b>
              <span>{e.place[lang]}</span>
              <span class="caption">{e.years[lang]}</span>
            </li>
          ))
        }
      </ul>
    </li>
  </ol>
</section>

<style>
  .stem {
    --stem-x: 11px;
    position: relative;
    display: grid;
    gap: var(--space-xl);
    padding: 0;
    padding-inline-start: 2.6rem;
    list-style: none;
  }
  /* the stem itself: from the first bud down to school */
  .stem::before {
    content: '';
    position: absolute;
    inset-block: 14px 1.2rem;
    inset-inline-start: calc(var(--stem-x) - 1.5px);
    width: 3px;
    background: var(--bronze-soft);
  }
  .node {
    position: absolute;
    inset-inline-start: calc(var(--stem-x) - 9px);
    inset-block-start: 0.55rem;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--plaster);
    border: 3px solid var(--bronze-soft);
  }
  .node--bud {
    inset-inline-start: calc(var(--stem-x) - 12px);
    inset-block-start: 0.4rem;
    width: 24px;
    height: 24px;
    background: var(--lime);
    border: 2px solid var(--ink);
  }

  .job,
  .school {
    position: relative;
    margin-inline-start: -2.6rem;
    padding-inline-start: 2.6rem;
    scroll-margin-block-start: 1rem;
  }
  .job {
    display: grid;
    gap: var(--space-m);
  }
  @media (min-width: 960px) {
    .job {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-xl);
      align-items: start;
    }
  }

  .job__company {
    font-size: var(--step-3);
    line-height: 1.1;
  }
  .job__company a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--ink);
    text-decoration: none;
  }
  .job__company a :global(svg) {
    color: var(--ink-faint);
    transition: translate var(--dur-ui) var(--ease-out), color var(--dur-hover) var(--ease-out);
  }
  :global(:root[dir='rtl']) .job__company a :global(svg) {
    scale: -1 1;
  }
  .job__company a:hover :global(svg) {
    color: var(--ink);
    translate: calc(2px * var(--dir)) -2px;
  }
  .job__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
    margin-block-start: 0.6rem;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }
  .job__when {
    padding: 0.15rem 0.6rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-sm);
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .job__role {
    margin-block-start: var(--space-s);
    font-weight: 600;
  }
  .job__about {
    margin-block-start: 0.35rem;
    line-height: 1.65;
    color: var(--ink);
    max-width: 48ch;
  }
  .job__products {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-m);
    margin-block-start: 0.4rem;
  }
  .job__products a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-height: 40px;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration-color: var(--rule);
    text-underline-offset: 0.25em;
  }
  .job__products a:hover {
    text-decoration-color: var(--lime-ink);
  }
  .job__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-block-start: var(--space-xs);
    padding: 0;
    list-style: none;
  }
  .job__stack li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.84rem;
    color: var(--ink-soft);
  }

  /* what I built there: a recess in the wall, not a floating card */
  .built {
    padding: var(--space-m);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--plaster-lift);
  }
  .built__title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
  .built ul {
    display: grid;
    gap: 0.6rem;
    margin-block-start: 0.8rem;
    padding: 0;
    list-style: none;
  }
  .built li {
    position: relative;
    padding-inline-start: 1.3rem;
    color: var(--ink);
    font-size: 0.97rem;
    line-height: 1.5;
  }
  /* each item a small commit on its own twig */
  .built li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.5em;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 2px solid var(--bronze-soft);
  }

  .school__head {
    display: flex;
    align-items: flex-end;
    gap: var(--space-xs);
  }
  .school__title {
    font-size: var(--step-2);
  }
  .school__head :global(.school__nix) {
    width: 64px;
    margin-block-end: -0.2rem;
  }
  #work {
    --anchor-extra: -64px;
  }
  .work__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-s);
  }
  /* Nix at his desk: the day job */
  .work__head :global(.work__nix) {
    width: clamp(84px, 11vw, 130px);
    margin-block-end: var(--space-s);
  }
  .school__list {
    display: grid;
    gap: 0.5rem;
    margin-block-start: var(--space-s);
    padding: 0;
    list-style: none;
  }
  .school__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.6rem;
    color: var(--ink-soft);
  }
  .school__list b {
    color: var(--ink);
    font-weight: 600;
  }
</style>
