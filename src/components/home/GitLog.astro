---
import type { Lang } from '../../i18n/ui';
import { useT } from '../../i18n/utils';
import { jobs, education } from '../../data/profile';
import SectionHead from '../ui/SectionHead.astro';
import Window from '../ui/Window.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
// deterministic short "hashes" from the message
const hash = (s: string) => {
  let h = 2166136261;
  for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return (h >>> 0).toString(16).padStart(8, '0').slice(0, 7);
};
const typeOf = (msg: string) => msg.match(/^(\w+)(\([^)]*\))?:/);
---

<section class="section wrap" id="work" aria-labelledby="work-title">
  <SectionHead cmd="git log --graph --oneline" title={t('work.title')} id="work-title" />
  <Window title="git log — ~/career" meta="--graph --oneline" class="gitlog rise">
    <ol class="log" role="list">
      {
        jobs.map((j, ji) => (
          <li class:list={['job', `job--${ji}`]}>
            <div class="job__head">
              <p class="job__refs mono">
                <span class="ref ref--head">HEAD</span>
                <span class="ref">{j.branch}</span>
              </p>
              <h3 class="job__company">
                {j.url ? <a href={j.url} target="_blank" rel="noopener">{j.company}</a> : j.company}
              </h3>
              <p class="job__where">
                {j.place[lang]} · {j.mode[lang]}
                <br />
                <span class="tabular">{j.since[lang]} – {t('work.now')}</span>
              </p>
              {j.lead && <p class="job__lead">{j.lead[lang]}</p>}
            </div>
            <ul class="commits" role="list">
              {j.commits[lang].map((msg, ci) => {
                const m = typeOf(msg);
                return (
                  <li class="commit">
                    <span class="lane" aria-hidden="true"><span class:list={['node', { 'node--big': ci === 0 }]} /></span>
                    <span class="commit__hash mono" aria-hidden="true">{hash(msg)}</span>
                    <span class="commit__msg">
                      {m ? (
                        <>
                          <b class:list={['ctype', `ctype--${m[1]}`]}>{m[0]}</b>
                          {msg.slice(m[0].length)}
                        </>
                      ) : (
                        msg
                      )}
                    </span>
                  </li>
                );
              })}
            </ul>
          </li>
        ))
      }
      <li class="job job--edu">
        <div class="job__head">
          <p class="job__refs mono"><span class="ref ref--tag">tags</span></p>
          <h3 class="job__company">{t('work.edu')}</h3>
        </div>
        <ul class="commits" role="list">
          {
            education.map((e, i) => (
              <li class="commit commit--tag">
                <span class="lane" aria-hidden="true"><span class="node node--tag" /></span>
                <span class="commit__hash mono" aria-hidden="true">v0.{education.length - 1 - i}</span>
                <span class="commit__msg">
                  <b>{e.title[lang]}</b> — {e.place[lang]} <span class="tabular">({e.years[lang]})</span>
                </span>
              </li>
            ))
          }
        </ul>
      </li>
    </ol>
  </Window>
</section>

<style>
  :global(.gitlog .win__body) {
    padding-block: var(--space-m);
  }
  .log {
    display: grid;
  }
  .job {
    --lane-c: var(--lime);
    display: grid;
    gap: var(--space-s) var(--space-l);
    padding-block: var(--space-m);
  }
  .job + .job {
    border-block-start: 1.5px dashed var(--edge-soft);
  }
  .job:first-child {
    padding-block-start: 0;
  }
  .job:last-child {
    padding-block-end: 0;
  }
  .job--0 {
    --lane-c: var(--amber);
  }
  .job--edu {
    --lane-c: var(--edge-soft);
  }
  @media (min-width: 900px) {
    .job {
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    }
  }
  .lane {
    position: relative;
    flex: none;
    width: 18px;
    align-self: stretch;
    display: grid;
    justify-items: center;
  }
  .lane::before {
    content: '';
    position: absolute;
    inset-block: 0;
    width: 3px;
    background: var(--lane-c);
    transform-origin: top;
  }
  .commit:first-child .lane::before {
    inset-block-start: 0.6em;
  }
  .commit:last-child .lane::before {
    inset-block-end: auto;
    height: 0.8em;
  }
  .node {
    position: relative;
    margin-block-start: 0.4em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg-2);
    border: 3px solid var(--lane-c);
  }
  .node--big {
    width: 16px;
    height: 16px;
    margin-block-start: 0.3em;
    background: var(--lane-c);
    border: 2px solid var(--edge);
  }
  .node--tag {
    border-radius: 3px;
    rotate: 45deg;
    background: var(--cream);
    border-color: var(--edge);
    border-width: 2px;
  }
  .job__refs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.74rem;
    direction: ltr;
  }
  .ref {
    padding: 0.05em 0.55em;
    border: 1.5px solid var(--lane-c, var(--edge-soft));
    border-radius: var(--radius-pill);
    color: var(--lane-c, var(--text-soft));
  }
  :global(:root[data-theme='light']) .ref {
    color: var(--text);
  }
  .ref--head {
    background: var(--lane-c);
    color: #0b0c09;
    border-color: var(--lane-c);
  }
  .ref--tag {
    border-color: var(--edge-soft);
    color: var(--text-soft);
  }
  .job__company {
    font-size: var(--step-2);
    margin-block: 0.4rem 0.2rem;
  }
  .job__company a {
    color: var(--text);
    text-decoration-color: var(--lane-c);
  }
  .job__where {
    color: var(--text-soft);
    font-size: var(--step--1);
  }
  .job__lead {
    margin-block-start: var(--space-2xs);
    font-size: 0.95rem;
  }
  .commits {
    display: grid;
    align-content: start;
  }
  .commit {
    display: flex;
    gap: var(--space-s);
    align-items: flex-start;
    padding-block: 0.2rem;
    font-size: 0.95rem;
  }
  .commit__hash {
    flex: none;
    padding-block-start: 0.15em;
    font-size: 0.78rem;
    color: var(--amber);
    direction: ltr;
  }
  :global(:root[data-theme='light']) .commit__hash {
    color: #9a5b00;
  }
  .commit__msg {
    min-width: 0;
    color: var(--text-soft);
  }
  .ctype {
    font-family: var(--ff-mono);
    font-weight: 600;
    font-size: 0.88em;
    color: var(--lime-ink);
    direction: ltr;
    unicode-bidi: isolate;
  }
  .ctype--perf {
    color: var(--amber);
  }
  :global(:root[data-theme='light']) .ctype--perf {
    color: #9a5b00;
  }
  .ctype--chore,
  .ctype--ci {
    color: var(--text-faint);
  }
  .commit--tag .commit__msg b {
    color: var(--text);
  }
  @media (max-width: 560px) {
    .commit__hash {
      display: none;
    }
  }
  /* the graph lines draw as you scroll */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      :global(html:not([data-lite])) .lane::before {
        animation: lane-draw linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 40%;
      }
    }
  }
  @keyframes lane-draw {
    from {
      scale: 1 0;
    }
  }
</style>
